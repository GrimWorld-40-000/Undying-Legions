	 <!-- Disintegrator - sniper for deathmark, outranged by specialized snipers -->
	<ThingDef ParentName="GW40k_Necron_BaseMakeableGun">
		<defName>GW40k_Necron_Disintegrator</defName>
		<label>Disintegrator</label>
		<description>The Synaptic Disintegrator is a long-barreled particle rifle designed for precise targeting and devastating damage. Disintegrators bypass most traditional armor, focusing primarily on destruction of tissue.\n\n&lt;color=#39C814&gt;Requires Gauss energy.&lt;/color&gt;</description>
		<graphicData>
			<texPath>Things/Items/NecronWeapons/Disintegrator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.00</drawSize>
		</graphicData>
		<recipeMaker>
			<skillRequirements>
				<Crafting>18</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<WorkToMake>34000</WorkToMake>
			<Mass>4.5</Mass>
			<MarketValue>4600</MarketValue>
			<AccuracyTouch>0.55</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.70</AccuracyMedium>
			<AccuracyLong>0.60</AccuracyLong>
			<RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown> <!-- worse than vanilla sniper -->
		</statBases>
		<costList>
			<ComponentSpacer>15</ComponentSpacer>
			<ComponentIndustrial>30</ComponentIndustrial>
			<GW40k_Necron_Component>15</GW40k_Necron_Component>
			<GW40k_Necron_Necrodermis>150</GW40k_Necron_Necrodermis>
		</costList>
		<weaponTags>
			<li>GW_Necron_Ranged</li>
			<li>GW_Necron_Ranged_Disintegrator</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>GW40k_Necron_Laser</defaultProjectile>
				<warmupTime>3.5</warmupTime>
				<range>36</range>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>  <!--  only 1 - Crazy op -->
				<soundCast>Shot_ChargeRifle</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>11</muzzleFlashScale>
			</li>
		</verbs>
		<weaponTags>
			<li>GW_Necron_Ranged</li>
		</weaponTags>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<equippedAngleOffset>45</equippedAngleOffset>
		<modExtensions>
			<li Class="GW40K_Necrons.ModExtension_GaussWeapon">
				<gaussConsumption>0.112</gaussConsumption>
			</li>
		</modExtensions>
	</ThingDef>

