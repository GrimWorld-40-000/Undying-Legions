	<AbilityDef>
		<defName>GW40K_ScarabLeap</defName>
		<label>leap</label>
		<description>The swarm launches itself in a burst of skittering legs, closing a short distance in an instant. Once spent, the scarabs require time to coil and ready themselves again.</description>
		<iconPath>UI/Abilities/GW40k_ScarabJump</iconPath>
		<cooldownTicksRange>2000</cooldownTicksRange>
		<!-- aiCanUse disabled: JobGiver_AIAbilityFight was using this without wall/proximity
		     checks, causing the leap loop. Custom job givers (JobGiver_ScarabLeapOverWall,
		     JobGiver_ScarabSiegeLeapToObjective) manage the leap with proper guards. -->
		<aiCanUse>false</aiCanUse>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>8.9</range>
			<warmupTime>0.5</warmupTime>
