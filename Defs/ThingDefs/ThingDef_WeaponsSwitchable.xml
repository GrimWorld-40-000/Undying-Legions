<Defs>

	<ThingDef ParentName="GW40k_Necron_MeleeMakeable">
		<defName>GW40k_Necron_Staff</defName>
		<label>necron staff</label>
		<description>The staff of light is the quintessential symbol of nobility and a marvel of technology. The head of the staff is embedded with a microscopic power matrix that captures and stores the energy of stars. In combat it is a versatile weapon that can be switched between melee and ranged mode. This staff is configured for melee attacks.\n\n The staff of light is a status symbol, only to be carried by Lords and Overlords. Carriers are often looked upon as a vengeful god wielding the power of the sun.</description>
		<graphicData>
			<texPath>Things/Items/NecronWeapons/Necron_Staff</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.0</drawSize>
		</graphicData>
		<uiIconScale>1.0</uiIconScale>				
		<statBases>
			<WorkToMake>50000</WorkToMake>
			<Mass>2.85</Mass>
		</statBases>
		<equippedAngleOffset>-30</equippedAngleOffset>
		<stuffCategories>
			<!-- <li>Imperial_Metals</li> -->
		</stuffCategories>
		<!-- <costStuffCount>200</costStuffCount> -->
		<costList>
			<ComponentSpacer>15</ComponentSpacer>
			<ComponentIndustrial>30</ComponentIndustrial>
			<GW40k_Necron_Component>5</GW40k_Necron_Component>
			<GW40k_Necron_Necrodermis>100</GW40k_Necron_Necrodermis>
		</costList>
		<weaponTags>
			<li>GW_Necron_Melee_Staff</li>
		</weaponTags>
		<tools>
			<li>
			<label>handle</label>
			<capacities>
				<li>Blunt</li>
			</capacities>
			<power>9</power>
			<cooldownTime>2.5</cooldownTime>
			<armorPenetration>0.2</armorPenetration>
			</li>
			<li>
			<label>point</label>
			<capacities>
				<li>Stab</li>
			</capacities>
			<power>40</power>
			<cooldownTime>1.0</cooldownTime>
			<armorPenetration>1.1</armorPenetration>
			</li>
			<li>
			<label>edge</label>
			<capacities>
				<li>Cut</li>
			</capacities>
			<power>29</power>
			<cooldownTime>2</cooldownTime>
			<armorPenetration>0.8</armorPenetration>
			</li>
		</tools>	
		<comps>
			<li Class="WeaponSwitch.CompProperties_SwitchWeapon">
				<weaponsToSwitch>
					<li>
						<label>Melee</label>
						<description>Swap to Ranged</description>
						<texPath>Things/Items/NecronWeapons/Necron_Staff</texPath>
						<weapon>GW40k_Necron_StaffR</weapon>
					</li>
				</weaponsToSwitch>
			</li>
		</comps>		
	</ThingDef>
