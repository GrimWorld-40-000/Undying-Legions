<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Converted from old-style MSBuild format to SDK-style to resolve:
    MSB3644: reference assemblies for .NETFramework v4.7.2 not found.
    The SDK-style format works with the installed .NET SDK without requiring
    the separate .NET Framework 4.7.2 Developer Pack.

    Removed <Compile> items: SDK-style auto-includes all .cs files recursively,
    so explicit file listings are unnecessary.

    Removed <Reference Include="System" /> and <Reference Include="System.Core" />:
    these BCL assemblies are automatically referenced for net472 by the SDK.

    Removed <Analyzer> items pointing to RimWorld DLLs: those were not valid
    Roslyn analyzers and had no effect on compilation.

    Removed old MSBuild boilerplate (ProjectGuid, ToolsVersion, Configuration/Platform
    PropertyGroups): SDK-style projects handle these automatically.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GW40K_Necrons</AssemblyName>
    <RootNamespace>GW40K_Necrons</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Suppress SDK auto-generated AssemblyInfo to avoid conflict with our AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uses $(SteamPath) and $(RimworldPath) environment variables -->
    <Reference Include="0Harmony">
      <HintPath>$(SteamPath)\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimworldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimworldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
