           vanilla burst mechanics handle ticksBetweenBurstShots natively. -->
      <li>
        <verbClass>GW40K_Necrons.Verb_SpyderSiegeCannon</verbClass>
        <hasStandardCommand>false</hasStandardCommand>
        <defaultProjectile>GW_UL_SpyderCannonShell</defaultProjectile>
        <warmupTime>30</warmupTime>
        <range>500</range>
        <minRange>33</minRange>
        <ticksBetweenBurstShots>30</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <forcedMissRadius>8</forcedMissRadius>
        <requireLineOfSight>false</requireLineOfSight>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <ai_AvoidFriendlyFireRadius>7</ai_AvoidFriendlyFireRadius>
        <soundCast>GW_Plasma_Gun_Sound</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
        </targetParams>
