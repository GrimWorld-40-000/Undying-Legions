<Defs>

	<PawnKindDef Name="UD_NecronPawnKindBase" Abstract="True">
		<race>GW40K_NecronWarrior</race>
		<defaultFactionDef>UD_NecronFaction</defaultFactionDef>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<invNutrition>2.55</invNutrition>
		<itemQuality>Normal</itemQuality>
		<backstoryCryptosleepCommonality>0.08</backstoryCryptosleepCommonality>
		<!-- Ancient necrons: generate as old adults by default -->
		<minGenerationAge>200</minGenerationAge>
		<maxGenerationAge>10000</maxGenerationAge>
		<combatEnhancingDrugsChance>0.15</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~2</combatEnhancingDrugsCount>
		<biocodeWeaponChance>0.1</biocodeWeaponChance>
	</PawnKindDef>
	
	<PawnKindDef Abstract="True" Name="UD_NecronRangedBase" ParentName="UD_NecronPawnKindBase">
    <race>GW40K_NecronWarrior</race>
    <gearHealthRange>0.7~2.3</gearHealthRange>
	<initialResistanceRange>9999~9999</initialResistanceRange>
    <initialWillRange>9999~9999</initialWillRange>
    <apparelTags Inherit="False" />
    <apparelMoney>0</apparelMoney>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <weaponMoney>9999~9999</weaponMoney>
    <techHediffsChance>0.05</techHediffsChance>
    <techHediffsMoney>500~500</techHediffsMoney>
    <techHediffsTags>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <disallowedTraits>
      <li>Brawler</li>
    </disallowedTraits>
    <inventoryOptions>
      <skipChance>0.95</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>MedicineIndustrial</thingDef>
          <countRange>1</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>
  
  <PawnKindDef ParentName="UD_NecronRangedBase">
    <defName>UD_NecronCryptek</defName>
    <label>Cryptek</label>
    <race>GW40K_NecronCryptek</race>
    <!-- Reference only — Biotech fur uses GW_UD_NecronCryptek renderNodeProperties/drawSize.
    <lifeStages>
      <li>
        <bodyGraphicData>
          <drawSize>0.95</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    -->
    <combatPower>200</combatPower>
    <canBeSapper>false</canBeSapper>
    <isGoodBreacher>false</isGoodBreacher>
    <weaponMoney>3800~5000</weaponMoney>
    <weaponTags>
      <li>GW_Necron_Ranged_Staff</li>
    </weaponTags>
    <invNutrition>0</invNutrition>
    <inventoryOptions Inherit="False">
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GW40K_GaussCore</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>NecronCryptek</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
	<xenotypeSet Inherit="False">
		<xenotypeChances>
			<GW_UD_NecronCryptek>1</GW_UD_NecronCryptek>
		</xenotypeChances>
	</xenotypeSet>
  </PawnKindDef>

  <PawnKindDef ParentName="UD_NecronRangedBase">
    <defName>UD_NecronOverlord</defName>
    <label>Overlord</label>
    <!-- Use the Overlord-specific race ThingDef (GW40K_BaseNecronRace lineage) so the
         work-mode comp inherited from GW40K_NecronWarrior does not appear on this pawn. -->
    <race>GW40K_NecronOverlord</race>
    <!-- Reference only — Biotech fur uses GW_UD_NecronOverlord renderNodeProperties/drawSize.
    <lifeStages>
      <li>
        <bodyGraphicData>
          <drawSize>1.2</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    -->
	<factionLeader>true</factionLeader>
    <combatPower>300</combatPower>
    <canBeSapper>true</canBeSapper>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponMoney>3900~5000</weaponMoney>
    <weaponTags>
      <li>GW_Necron_Melee_Warscythe</li>
    </weaponTags>
    <invNutrition>0</invNutrition>
    <inventoryOptions Inherit="False">
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GW40K_GaussCore</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>NecronOverlord</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
	<xenotypeSet Inherit="False">
		<xenotypeChances>
			<GW_UD_NecronOverlord>1</GW_UD_NecronOverlord>
		</xenotypeChances>
	</xenotypeSet>
  </PawnKindDef>
  
  <!-- Abstract base for lowborn Necron pawnkinds. Forces the NecronLowborn backstory pool
       (GW_UD_PurgedMemories_Child / Adult). Lychguard and Deathmark add their own backstory categories. -->
  <PawnKindDef Name="UD_NecronLowbornBase" ParentName="UD_NecronRangedBase" Abstract="True">
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>NecronLowborn</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>

  <PawnKindDef ParentName="UD_NecronLowbornBase">
    <defName>UD_NecronLychguard</defName>
    <label>Lychguard</label>
    <!-- Use the Lychguard-specific race ThingDef so the Warrior work-mode comp is absent. -->
    <race>GW40K_NecronLychGuard</race>
    <!-- Reference only — both Lychguard pawn kinds share GW_UD_NecronLychguard fur drawSize (1.2).
    <lifeStages>
      <li>
        <bodyGraphicData>
          <drawSize>1.2</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    -->
    <combatPower>225</combatPower>
    <canBeSapper>true</canBeSapper>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponMoney>3200~4500</weaponMoney>
    <weaponTags>
      <li>GW_Necron_Melee_HyperSword</li>
    </weaponTags>
    <invNutrition>0</invNutrition>
    <inventoryOptions Inherit="False">
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GW40K_GaussCore</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <apparelRequired>
      <li>GM40k_Necron_Shield</li>
    </apparelRequired>
    <backstoryFiltersOverride Inherit="False">
      <li>
        <categories>
          <li>NecronLowborn</li>
          <li>NecronLychguard</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
	<xenotypeSet Inherit="False">
		<xenotypeChances>
			<GW_UD_NecronLychguard>1</GW_UD_NecronLychguard>
		</xenotypeChances>
	</xenotypeSet>
  </PawnKindDef>

  <PawnKindDef ParentName="UD_NecronLowbornBase">
    <defName>UD_NecronLychguard_2</defName>
    <label>Lychguard</label>
    <race>GW40K_NecronLychGuard</race>
    <!-- Reference only — same body gene/xenotype as UD_NecronLychguard; drawSize 1.2 on GW_UD_NecronLychguard.
    <lifeStages>
      <li>
        <bodyGraphicData>
          <drawSize>1.2</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    -->
    <combatPower>200</combatPower>
    <canBeSapper>true</canBeSapper>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponMoney>3900~5000</weaponMoney>
    <weaponTags>
      <li>GW_Necron_Melee_Warscythe</li>
    </weaponTags>
    <invNutrition>0</invNutrition>
    <inventoryOptions Inherit="False">
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GW40K_GaussCore</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <backstoryFiltersOverride Inherit="False">
      <li>
        <categories>
          <li>NecronLowborn</li>
          <li>NecronLychguard</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
	<xenotypeSet Inherit="False">
		<xenotypeChances>
			<GW_UD_NecronLychguard>1</GW_UD_NecronLychguard>
		</xenotypeChances>
	</xenotypeSet>
  </PawnKindDef>

  <PawnKindDef ParentName="UD_NecronLowbornBase">
    <defName>UD_NecronDeathmark</defName>
    <label>Deathmark</label>
    <preventIdeo MayRequire="Ludeon.RimWorld.Ideology">true</preventIdeo>
    <!-- Reference only — Biotech fur uses GW_UD_NecronDeathmark renderNodeProperties/drawSize.
    <lifeStages>
      <li>
        <bodyGraphicData>
          <drawSize>0.85</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    -->
    <combatPower>200</combatPower>
    <canBeSapper>true</canBeSapper>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponTags>
      <li>GW_Necron_Ranged_Disintegrator</li>
    </weaponTags>
    <invNutrition>0</invNutrition>
    <inventoryOptions Inherit="False">
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GW40K_GaussCore</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
    <backstoryFiltersOverride Inherit="False">
      <li>
        <categories>
          <li>NecronLowborn</li>
          <li>NecronDeathmark</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
	<xenotypeSet Inherit="False">
		<xenotypeChances>
			<GW_UD_NecronDeathmark>1</GW_UD_NecronDeathmark>
		</xenotypeChances>
	</xenotypeSet>
  </PawnKindDef>

  <!-- Vekh Thrall: a human slave conscripted as a necrodermis growth host.
       Regular human baseline, pre-industrial weapon, tribal clothes.
       Backstory and trait are forced; Painblocker + necrodermis hediffs granted by Harmony patch. -->

  <!-- Shared base: all three Vekh Thrall variants inherit from this. -->
  <PawnKindDef ParentName="TribalBase" Name="GW_UL_VekhThrallBase" Abstract="True">
    <combatPower>35</combatPower>
    <isFighter>true</isFighter>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <minGenerationAge>20</minGenerationAge>
    <maxGenerationAge>45</maxGenerationAge>
    <itemQuality>Poor</itemQuality>
    <!-- gearHealthRange required — TribalBase has none; without it gear generates at 0 health
         and is culled before spawn, leaving the pawn naked. -->
    <gearHealthRange>0.3~1.2</gearHealthRange>
    <apparelTags Inherit="False">
      <li>Neolithic</li>
    </apparelTags>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <!-- Keep below ~70 so ShieldPrimitive (moves speed -20%) is never generated. -->
    <apparelMoney>30~65</apparelMoney>
    <!-- weaponMoney floor raised to 40 — cheapest NeolithicMeleeBasic weapon costs 38.7sv. -->
    <weaponMoney>40~70</weaponMoney>
    <backstoryFiltersOverride>
      <!-- Weight 1: Vekh Thrall backstory (~20% — fully processed thrall) -->
      <li>
        <categories>
          <li>VekhThrall</li>
        </categories>
        <commonality>1</commonality>
      </li>
      <!-- Weight 4: vanilla human backstory (~80% — recently captured, identity still intact) -->
      <li>
        <categories>
          <li>Outlander</li>
          <li>Offworld</li>
        </categories>
        <commonality>4</commonality>
      </li>
    </backstoryFiltersOverride>
    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances>
        <Baseliner>1</Baseliner>
      </xenotypeChances>
    </xenotypeSet>
    <initialResistanceRange>6~12</initialResistanceRange>
    <initialWillRange>0~0</initialWillRange>
    <invNutrition>1</invNutrition>
    <techHediffsChance>0</techHediffsChance>
  </PawnKindDef>

  <!-- Standard — basic pre-industrial melee (clubs, knives, short swords). -->
  <PawnKindDef ParentName="GW_UL_VekhThrallBase">
    <defName>GW_UL_VekhThrall</defName>
    <label>vekh thrall</label>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
    </weaponTags>
  </PawnKindDef>

  <!-- Breacher — breach axe; ordered to destroy walls during breach raids and Stage 3 siege. -->
  <PawnKindDef ParentName="GW_UL_VekhThrallBase">
    <defName>GW_UL_VekhThrall_Breacher</defName>
    <label>vekh thrall (breacher)</label>
    <isGoodBreacher>true</isGoodBreacher>
    <weaponTags>
      <li>NeolithicMeleeDestructive</li>
    </weaponTags>
    <weaponMoney>90~150</weaponMoney>
  </PawnKindDef>

  <!-- Sapper — breach axe; tunnels and mines around defences during sapper raids and Stage 3 siege. -->
  <PawnKindDef ParentName="GW_UL_VekhThrallBase">
    <defName>GW_UL_VekhThrall_Sapper</defName>
    <label>vekh thrall (sapper)</label>
    <canBeSapper>true</canBeSapper>
    <weaponTags>
      <li>NeolithicMeleeDestructive</li>
    </weaponTags>
    <weaponMoney>90~150</weaponMoney>
  </PawnKindDef>


</Defs>