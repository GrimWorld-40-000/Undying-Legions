<Defs>

    <!-- Requires GrimWorld Core Imperialis — designed by the Adeptus Mechanicus / Inquisitorial biologis -->

    <ThingDef ParentName="ResourceBase" MayRequire="Grimworld.Core">
        <defName>GW40k_LithoPhagicAcid</defName>
        <label>litho-phagic acid</label>
        <description>A "smart" acid developed by the Adeptus Mechanicus and refined by Inquisitorial biologis. Chemically inert against carbon-based tissue, it reacts violently when it detects the specific isotopes found in Necrodermis. Seeking agents bind to the metallic lattice of Necron nanobots and trigger an exothermic reaction that dissolves the living metal into an inert metallic salt.\n\nThe catch: the reaction releases superheated chlorine gas and corrosive thermal energy. Expect chemical burns.</description>
        <graphicData>
            <texPath>Things/Items/NanobotSolvent/LithoPhaegicAcid</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <!-- drawSize preserves aspect ratio of the smallest texture (51x97 ≈ 0.53:1)
            <drawSize>(0.53, 1.0)</drawSize> -->
        </graphicData>
        <rotatable>false</rotatable>
        <statBases>
            <MarketValue>350</MarketValue>
            <Mass>0.15</Mass>
        </statBases>
        <techLevel>Spacer</techLevel>
        <stackLimit>5</stackLimit>
        <thingCategories>
            <li>Medicine</li>
        </thingCategories>
        <allowedArchonexusCount>5</allowedArchonexusCount>
    </ThingDef>

    <RecipeDef MayRequire="Grimworld.Core">
        <defName>GW40k_AdministerLithoPhagicAcid</defName>
        <label>administer litho-phagic acid</label>
        <description>Administer litho-phagic acid to neutralize a necrodermis seed. The exothermic reaction will cause chemical burns proportional to the amount of necrodermis present.</description>
        <workerClass>NecronMod.RecipeWorker_LithoPhagicAcid</workerClass>
        <jobString>administering litho-phagic acid</jobString>
        <workAmount>2000</workAmount>
        <allowMixingIngredients>false</allowMixingIngredients>
        <recipeUsers>
            <li>Human</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>GW40k_LithoPhagicAcid</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>GW40k_LithoPhagicAcid</li>
            </thingDefs>
        </fixedIngredientFilter>
        <!-- Uncomment to require Imperium Drug Production research before this recipe appears -->
        <!--<researchPrerequisite MayRequire="Grimworld.Core">GW_DrugProduction</researchPrerequisite>-->
        <skillRequirements>
            <Medicine>6</Medicine>
        </skillRequirements>
        <appliedOnFixedBodyParts>
            <li>Torso</li>
        </appliedOnFixedBodyParts>
    </RecipeDef>

</Defs>
