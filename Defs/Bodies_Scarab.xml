<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Body part groups — one per scarab in the swarm, linked to render nodes -->
  <BodyPartGroupDef><defName>GW40K_ScarabA</defName></BodyPartGroupDef>
  <BodyPartGroupDef><defName>GW40K_ScarabB</defName></BodyPartGroupDef>
  <BodyPartGroupDef><defName>GW40K_ScarabC</defName></BodyPartGroupDef>
  <BodyPartGroupDef><defName>GW40K_ScarabD</defName></BodyPartGroupDef>

  <!-- Invisible root chassis — 0 coverage so it can never be hit directly -->
  <BodyPartDef ParentName="GW40K_Necron_BodyPartBase">
    <defName>GW40K_ScarabSwarm_Chassis</defName>
    <label>swarm chassis</label>
    <hitPoints>10</hitPoints>
    <solid>true</solid>
    <bleedRate>0</bleedRate>
  </BodyPartDef>

  <!-- One body part per scarab — each is vital so losing it degrades the swarm -->
  <BodyPartDef ParentName="GW40K_Necron_BodyPartBase">
    <defName>GW40K_ScarabUnit</defName>
    <label>scarab</label>
    <hitPoints>750</hitPoints>
    <bleedRate>0</bleedRate>
    <frostbiteVulnerability>0.01</frostbiteVulnerability>
    <tags>
      <li>MovingLimbCore</li>
      <li>ManipulationLimbCore</li>
      <li>ConsciousnessSource</li>
      <li>SightSource</li>
    </tags>
  </BodyPartDef>

  <!-- Body: chassis root (0 coverage) with 4 scarab units (0.25 each = 1.0 total) -->
  <BodyDef>
    <defName>GW40K_ScarabSwarmBody</defName>
    <label>scarab swarm</label>
    <corePart>
      <def>GW40K_ScarabSwarm_Chassis</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>GW40K_ScarabUnit</def>
          <coverage>0.24</coverage>
          <customLabel>scarab</customLabel>
          <groups><li>GW40K_ScarabA</li></groups>
        </li>
        <li>
          <def>GW40K_ScarabUnit</def>
          <coverage>0.24</coverage>
          <customLabel>scarab</customLabel>
          <groups><li>GW40K_ScarabB</li></groups>
        </li>
        <li>
          <def>GW40K_ScarabUnit</def>
          <coverage>0.24</coverage>
          <customLabel>scarab</customLabel>
          <groups><li>GW40K_ScarabC</li></groups>
        </li>
        <li>
          <def>GW40K_ScarabUnit</def>
          <coverage>0.24</coverage>
          <customLabel>scarab</customLabel>
          <groups><li>GW40K_ScarabD</li></groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>

</Defs>
