<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Graded core-flux strain (A1): consciousness moved from body degradation; driven by HediffGiverNecron + MaintenanceNeed.CurCategory. Not used at CurLevel==0 (exhaustion + Eternal Slumber instead). -->
  <HediffDef>
    <defName>GW40K_Necron_TiredHediff</defName>
    <label>core flux strain</label>
    <description>Core flux reserves are low. Motor and cognitive engrams run below nominal efficiency until power is restored.</description>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.85, 0.92, 1.0)</defaultLabelColor>
    <stages>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>nominal</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>depleted</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>critical strain</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
