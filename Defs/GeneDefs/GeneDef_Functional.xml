		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<modExtensions>
			<li Class="NecronGeneUtil.GeneExtension_Necron">
				<hediffDef>GW40K_CommandProtocolImplant</hediffDef>
				<part>Brain</part>
				<severityOnAdd>1.0</severityOnAdd>
			</li>
