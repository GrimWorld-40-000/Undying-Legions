<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Same combat behaviour as Core PsychicInvisibility (HediffComp_Invisibility) — extradimensional / canoptek veil, not psyker fluff. -->
  <HediffDef>
    <defName>GW40K_FlayedOne_Stealth</defName>
    <label>ghostwind</label>
    <description>This pawn is out of phase with the normal world — ranged weapons and sensors struggle to target it.\n\nThose afflicted with the Flayer Virus develop the ability to "tunnel" through reality and inhabit a sub-dimension known as the Ghostwind.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 0.60)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>true</visibleToPlayer>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
  </HediffDef>
</Defs>
