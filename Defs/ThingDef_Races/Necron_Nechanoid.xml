<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!--
    Nechs are fully independent of the vanilla mech/mechanitor system.
    No CompOverseerSubject or CompMechRepairable — the Necron Command Protocol
    tracker handles all command, bandwidth, and uncontrolled logic directly.
  -->

  <!-- Mirrors BaseMechanoid (Core) + Biotech overseer/repair comps -->
  <ThingDef ParentName="BasePawn" Name="BaseNech" Abstract="True">
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <statBases>
      <MarketValue>1200</MarketValue>
      <PsychicSensitivity>1.0</PsychicSensitivity>
      <ToxicResistance>1</ToxicResistance>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>250</ComfyTemperatureMax>
      <MeatAmount>0</MeatAmount>
      <ArmorRating_Heat>2.00</ArmorRating_Heat>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
    </statBases>
    <receivesSignals>true</receivesSignals>
    <tradeability>None</tradeability>
    <race>
      <fleshType>Mechanoid</fleshType>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <foodType>None</foodType>
      <lifeExpectancy>2500</lifeExpectancy>
      <bloodDef>Filth_MachineBits</bloodDef>
      <soundCallIntervalRange>1000~2000</soundCallIntervalRange>
      <soundCallIntervalFriendlyFactor>2</soundCallIntervalFriendlyFactor>
      <canFlyInVacuum>true</canFlyInVacuum>
    </race>
    <comps>
      <li Class="CompProperties_CanBeDormant">
        <compClass>CompMechanoid</compClass>
      </li>
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
        <wakeUpCheckRadius>30</wakeUpCheckRadius>
        <wakeUpSound>MechanoidsWakeUp</wakeUpSound>
      </li>
      <li Class="GW40K_Necrons.CompProperties_NechUncontrolledTimer" />
    </comps>
    <modExtensions>
      <li Class="GW40K_Necrons.NecronMechExtension">
        <coreSize>1</coreSize>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Mirrors BaseMechanoidWalker (Core) -->
  <ThingDef ParentName="BaseNech" Name="BaseNechWalker" Abstract="True">
    <statBases>
      <MoveSpeed>4.7</MoveSpeed>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
    </statBases>
    <race>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <!-- Required for Biotech ResurrectionMech: cost lookup + canResurrect gate -->
      <mechWeightClass>Medium</mechWeightClass>
      <baseBodySize>1.0</baseBodySize>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
        <li MayRequire="Ludeon.RimWorld.Biotech">
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <butcherProducts>
      <Steel>15</Steel>
    </butcherProducts>
  </ThingDef>

  <!-- Mirrors LancerMechanoidWalker (Core) â€” fast, lighter -->
  <ThingDef Name="BaseNechLancer" ParentName="BaseNechWalker" Abstract="True">
    <tools>
      <li>
        <label>left fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities><li>Blunt</li></capacities>
        <power>12.0</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
      <li>
        <label>right fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities><li>Blunt</li></capacities>
        <power>12.0</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
    </tools>
    <race>
      <mechWeightClass>Light</mechWeightClass>
    </race>
  </ThingDef>

  <!-- Mirrors HeavyMechanoid (Biotech) -->
  <ThingDef ParentName="BaseNech" Name="BaseNechHeavy" Abstract="True" MayRequire="Ludeon.RimWorld.Biotech">
    <statBases>
      <MoveSpeed>1.9</MoveSpeed>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
    </statBases>
    <race>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <mechWeightClass>Heavy</mechWeightClass>
    </race>
    <butcherProducts>
      <Steel>20</Steel>
      <Plasteel>10</Plasteel>
    </butcherProducts>
  </ThingDef>


