		<maxGenerationAge>10000</maxGenerationAge>
	</PawnKindDef>

	<PawnKindDef Name="UD_NecronHeavyMechPawnKindBase" Abstract="True" ParentName="HeavyMechanoidKind">
		<defaultFactionDef>UD_NecronFaction</defaultFactionDef>
	</PawnKindDef>
	
