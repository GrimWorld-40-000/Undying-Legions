<Defs>

	<ThingDef ParentName="ResourceBase">
		<defName>GW40k_Necron_Component</defName>
		<label>black component</label>
		<description>necron component</description>
		<graphicData>
			<texPath>Things/Item/Resource/ComponentIndustrial</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>50</stackLimit>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<MarketValue>32</MarketValue>
			<Mass>0.6</Mass>
			<Flammability>0.6</Flammability>
			<DeteriorationRate>2.0</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<allowedArchonexusCount>10</allowedArchonexusCount>
	</ThingDef>
	
	<StuffCategoryDef>
    <defName>Metallic_Necron</defName>
    <label>necron</label>
    <noun>necron</noun>
    <destroySoundSmall>BuildingDestroyed_Metal_Small</destroySoundSmall>
    <destroySoundMedium>BuildingDestroyed_Metal_Medium</destroySoundMedium>
    <destroySoundLarge>BuildingDestroyed_Metal_Big</destroySoundLarge>
  </StuffCategoryDef>
	
	<!-- Raw necrodermis: listed with steel (ResourcesRaw). Necrons refill GW_UD_Necrodermis via CompUsable, not ingestible. -->
	<ThingDef ParentName="ResourceBase">
		<defName>GW40k_Necron_Necrodermis</defName>
		<label>necrodermis</label>
		<description>A viscous "living metal" sludge of nanites. Most see it only as a construction material; Necrons with a necrodermis core can metabolize stacks of it directly.</description>
		<graphicData>
			<texPath>Things/Items/Necrodermis</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Metal_Drop</soundDrop>
		<useHitPoints>false</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MarketValue>8.0</MarketValue>
			<Mass>0.025</Mass>
			<StuffPower_Armor_Sharp>0.9</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.45</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.60</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
			<SharpDamageMultiplier>1</SharpDamageMultiplier>
			<BluntDamageMultiplier>1</BluntDamageMultiplier>
		</statBases>
		<stuffProps>
			<categories>
				<li>Metallic_Necron</li>
			</categories>
			<appearance>Metal</appearance>
			<commonality>1.00</commonality>
			<constructEffect>ConstructMetal</constructEffect>
			<color>(105,105,105)</color>
			<soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
			<soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
			<soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
			<soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
			<statFactors>
				<MaxHitPoints>1</MaxHitPoints>
				<Beauty>1</Beauty>
				<Flammability>0.4</Flammability>
			</statFactors>
			<canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
		</stuffProps>
		<thingCategories>
			<li>ResourcesRaw</li>
		</thingCategories>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<allowedArchonexusCount>150</allowedArchonexusCount>
		<comps>
			<!-- Plague: old ingestible outcome doer plus HediffAura comp — re-enable in git history if desired. -->
			<li Class="NecronGeneUtil.CompProperties_UsableNecrodermisPack">
				<useJob>UseItem</useJob>
				<useLabel>Metabolize necrodermis</useLabel>
				<useDuration>450</useDuration>
				<showUseGizmo>true</showUseGizmo>
			</li>
			<li Class="NecronGeneUtil.CompProperties_UseEffectNecrodermisPackConsume">
				<nutritionPerUnit>0.05</nutritionPerUnit>
			</li>
			<li Class="CompProperties_UseEffectPlaySound">
				<soundOnUsed>Meal_Eat</soundOnUsed>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>GW_NecrodermisInjector</defName>
		<label>necrodermis injector</label>
		<description>A pressurized syringe containing a necrodermis seed suspended in a nutrient solution. Upon injection, the nanites immediately begin rewriting the host's genetic code to support living metal growth. This process is difficult to reverse and ultimately fatal.</description>
    <graphicData>
		<!-- Using MechSerumHealer texture with dark tint to differentiate from the standard serum -->
		<texPath>Things/Item/Special/MechSerumHealer</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		<color>(168, 211, 160)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
		<MarketValue>800</MarketValue>
		<Mass>0.1</Mass>
		<!-- Used by Thing.Ingested / nutrition-aligned refill (one strong dose) -->
		<Nutrition>0.9</Nutrition>
    </statBases>
    <techLevel>Ultra</techLevel>
    <ingestible>
		<foodType>OmnivoreAnimal</foodType>
		<preferability>NeverForNutrition</preferability>
		<outcomeDoers>
			<!-- Growth seed for organics only; Necrons with GW_UD_Necrodermis skip (handled by nutrition on use) -->
			<li Class="NecronMod.IngestionOutcomeDoer_GiveHediffUnlessNeedPresent">
				<hediffDef>Necron_NecrodermisGrowth</hediffDef>
				<severity>0.1</severity>
				<skipIfPawnHasNeed>GW_UD_Necrodermis</skipIfPawnHasNeed>
			</li>
			<!-- Mood for humanlikes; colonization is the growth hediff above (no separate raw-ingest roll) -->
			<li Class="NecronMod.IngestionOutcomeDoer_HumanRawNecrodermis">
				<thoughtDef>GW_UD_IngestedRawNecrodermis</thoughtDef>
				<colonizationChance>0</colonizationChance>
				<skipIfHasNeed>GW_UD_Necrodermis</skipIfHasNeed>
			</li>
		</outcomeDoers>
    </ingestible>
    <comps>
		<li Class="NecronGeneUtil.CompProperties_UsableNecrodermisInjector">
			<useJob>UseItem</useJob>
			<useLabel>Inject necrodermis seed</useLabel>
			<useDuration>600</useDuration>
			<showUseGizmo>true</showUseGizmo>
		</li>
		<li Class="CompProperties_UseEffect">
			<compClass>NecronGeneUtil.CompUseEffect_NecrodermisInjectorIngest</compClass>
		</li>
		<li Class="CompProperties_UseEffectPlaySound">
			<soundOnUsed>MechSerumUsed</soundOnUsed>
		</li>
    </comps>
	</ThingDef>

	<!-- Alias for legacy defName used in NecronGeneUtil.dll — resolves cross-reference error from old compiled assembly -->
	<ThingDef ParentName="ResourceBase">
		<defName>GW40k_Necron_Necrodemis</defName>
		<label>necrodermis (legacy)</label>
		<description>See GW40k_Necron_Necrodermis.</description>
		<graphicData>
			<texPath>Things/Items/Necrodermis/Necrodermis_a</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>8.0</MarketValue>
			<Mass>0.025</Mass>
		</statBases>
		<thingCategories>
			<li>ResourcesRaw</li>
		</thingCategories>
	</ThingDef>

</Defs>