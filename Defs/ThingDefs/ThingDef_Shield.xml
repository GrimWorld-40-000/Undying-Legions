<Defs>

	<ThingDef ParentName="GWShieldBase" Name="GWNecronShieldBase" Abstract="true">
		<description>Necron Shield</description>
		<apparel>
			<drawData>
				<defaultData>
					<layer>75</layer> <!--70-77 is over helmet and under gun-->
				</defaultData>
				<dataNorth>
					<offset>(0.0, -0.4, 0.1)</offset>
				</dataNorth>
				<dataSouth>
					<offset>(0.0, 0.0, 0.0)</offset>
				</dataSouth>
                <dataWest>
                    <offset>(-0.1, 0.0, 0.0)</offset>
                </dataWest>
                <dataEast>
                    <offset>(0.1, 0.0, 0.0)</offset>
                </dataEast>
                <scale>1.0</scale>
                <childScale>1.0</childScale>
            </drawData>
		</apparel>
		<statBases>
			<WorkToMake>15000</WorkToMake>
			<MaxHitPoints>2000</MaxHitPoints>
			<MarketValue>2300</MarketValue>
		</statBases>
		<recipeMaker>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>
	
	<ThingDef ParentName="GWNecronShieldBase">
		<defName>GM40k_Necron_Shield</defName>
		<label>dispersion shield</label>
		<description>A large, curved shield of living metal that can be deployed to protect the bearer from incoming attacks. The shield's surface is embedded with a complex array of energy-dispersing nodes that can absorb and redirect kinetic and energy-based projectiles, providing temporary invulnerability to the wielder at the cost of reduced mobility and offensive capability. The shield's regenerative properties allow it to recover from damage over time, making it an invaluable asset for frontline combatants who rely on durability and defense.</description>
		<graphicData>
			<texPath>Things/Items/NecronWeapons/Shield</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<comps>
			<li Class="GWParryShield.CompProperties_GW_Parryable">
				<parryHediff>GW40k_Necron_ShieldParry</parryHediff><!-- the parry hediff-->
				<parryChance>0.30</parryChance> <!-- 0.20 = 20% -->
				<parryWindow>30</parryWindow>
				<parryCooldown>90</parryCooldown>
			</li>
		</comps>
		<costStuffCount>200</costStuffCount>
		<costList>
			<ComponentSpacer>15</ComponentSpacer>
			<ComponentIndustrial>30</ComponentIndustrial>
			<GW40k_Necron_Component>6</GW40k_Necron_Component>
			<GW40k_Necron_Necrodermis>200</GW40k_Necron_Necrodermis>
		</costList>
		<stuffCategories Inherit="False">
			<li>Metallic_Necron</li>
		</stuffCategories>
		<statBases>
			<StuffEffectMultiplierArmor>1</StuffEffectMultiplierArmor>
			<Mass>7</Mass>
			<Bulk MayRequire="CETeam.CombatExtended">8</Bulk>
			<WornBulk MayRequire="CETeam.CombatExtended">5</WornBulk>
		</statBases>
		<equippedStatOffsets>
			<ReloadSpeed MayRequire="CETeam.CombatExtended">-0.2</ReloadSpeed>
			<MeleeHitChance>-1</MeleeHitChance>
			<ShootingAccuracyPawn>-0.15</ShootingAccuracyPawn>
			<AimingAccuracy MayRequire="CETeam.CombatExtended">-0.08</AimingAccuracy>
			<Suppressability MayRequire="CETeam.CombatExtended">-0.25</Suppressability>
			<MeleeCritChance MayRequire="CETeam.CombatExtended">-0.05</MeleeCritChance>
			<MeleeParryChance MayRequire="CETeam.CombatExtended">1.0</MeleeParryChance>
		</equippedStatOffsets>
		<apparel>			
			<wornGraphicPath>Things/Items/NecronWeapons/Shield/NecronShield</wornGraphicPath>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<tags>
				<li>GW_Necron_Shield</li>
			</tags>
		</apparel>
		<modExtensions>

   		 <li Class="CombatExtended.ShieldDefExtension" MayRequire="CETeam.CombatExtended">
        	<shieldCoverage>
            <li>Hands</li>
            <li>Arms</li>
            <li>Shoulders</li>
            <li>Torso</li>
            <li>Neck</li>
       	 </shieldCoverage>
    		</li>
		</modExtensions>

	</ThingDef>
	

</Defs>