<Defs>
	<GeneCategoryDef>
		<defName>GW_UD_NecronGene</defName>
		<label>Necron</label>
		<displayPriorityInXenotype>990</displayPriorityInXenotype>
	</GeneCategoryDef>
	<GeneDef>
		<defName>GW_UD_EternalSlumber</defName>
		<label>Eternal Slumber</label>
		<description>Grants the core flux need — the Necron equivalent of deathrest. Core flux depletes while the body is active and must be restored in a stasis crypt, monolith, or compatible suspension.</description>
		<iconPath>UI/Icons/Genes/Gene_Deathrest</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<enablesNeeds>
			<li>GW40K_CoreFlux</li>
		</enablesNeeds>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<minAgeActive>3</minAgeActive>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>death</symbol></li>
				<li><symbol>dead</symbol></li>
				<li><symbol>still</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>rester</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_ResurrectionProtocol</defName>
		<label>Resurrection Protocal</label>
		<description>When Necrons sustain critical damage, they enter Resurrection Protocol instead of dying. This allows them to self-repair and rise again as long as their two cores are intact.</description>
		<!-- <geneClass>Gene_Deathrest</geneClass> -->
		<iconPath>Genes/ResurectionProtocol</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<geneClass>GW40K_Necrons.Gene_ResurrectionProtocol</geneClass>
		<modExtensions>
			<li Class="GW40K_Necrons.GeneExtension_Resurrection">
        <ticksToResurrect>625</ticksToResurrect>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_BodyDegradation</defName>
		<label>Body Degradation</label>
		<description>Carriers of this gene have undergone Biotransference and are now composed of living metal called necrodermis. As a result they require a constant supply of necrodermis to maintain their body.</description>
		<!-- <geneClass>Gene_Deathrest</geneClass> -->
		<enablesNeeds>
			<li>GW_UD_Necrodermis</li>
		</enablesNeeds>
		<iconPath>Genes/BodyDegradation</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_LifeLess</defName>
		<label>Lifeless</label>
		<description>Carriers of this gene cannot feel emotions and are incapable of experiencing passions; This is due to a genetic imperfection that affects their ability to process emotions.</description>
		<geneClass>NecronGeneUtil.Gene_NoInspirationAndPassion</geneClass>
		<iconPath>Genes/Lifeless</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<modExtensions>
			<li Class="NecronGeneUtil.GeneExtension_Necron">
				<hediffDef>GW40K_Necron_Lifeless</hediffDef>
				<severityOnAdd>1.0</severityOnAdd>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_SlowAdvancement</defName>
		<label>Slow Advancement</label>
		<description>Carriers of this gene experience a significant slowdown in their work speed; This is due to a genetic imperfection that affects their ability to process information and perform tasks efficiently.</description>
		<!-- <geneClass>Gene_Deathrest</geneClass> -->
		<iconPath>Genes/inertia</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<statFactors>
			<WorkSpeedGlobal>0.7</WorkSpeedGlobal>
		</statFactors>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_Hatred</defName>
		<label>Hatred for the Living</label>
		<description>Carriers of this gene have an innate hatred for the living. This hatred varies from clinical indifference to obsessive, omnicidal rage depending on the individual's mindset or their specific dynasty.</description>
		<!-- <geneClass>Gene_Deathrest</geneClass> -->
		<iconPath>Genes/Hatred for the Living</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_ApparelRestriction</defName>
		<label>Apparel Incompatible</label>
		<description>Carriers of this gene are restricted from wearing apparel. Whether it's a static frame or fixed exoskeleton, these individuals cannot wear any apparel.</description>
		<geneClass>NecronGeneUtil.Gene_RemoveAllApparelOnAdd</geneClass>
		<iconPath>Genes/clotheless</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<modExtensions>
			<li Class="NecronGeneUtil.GeneExtension_Necron">
				<allowedApparels>
				</allowedApparels>
			</li>
		</modExtensions>
	</GeneDef>
	
	<!-- unique gene -->
	
	<GeneDef>
		<defName>GW_UD_NecronEmissary</defName>
		<label>Emmisarry</label>
		<description>Carriers of this gene have a natural aptitude for diplomacy and social interaction; This allows them to engage in negotiations and social interactions with a higher degree of success.</description>
		<iconPath>Genes/emmisarry</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<statFactors>
			<NegotiationAbility>1.15</NegotiationAbility>
			<SocialImpact>1.15</SocialImpact>
		</statFactors>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_Bodyguard</defName>
		<label>Bodyguard</label>
		<description>Carriers of this gene are melee specialists; They cannot equip ranged weapons but have a 15% bonus to dodge and don't lose experience in the melee skill.</description>
		<iconPath>Genes/Bodyguard</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<statOffsets>
			<MeleeDodgeChance>-15</MeleeDodgeChance>
		</statOffsets>
		<forcedTraits>
			<li>
				<def>Brawler</def>
			</li>
		</forcedTraits>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_CantWork</defName>
		<label>Can't Work</label>
		<description>. . .</description>
		<iconPath>Genes/inertia</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<disabledWorkTags>AllWork</disabledWorkTags>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_LowBorn</defName>
		<label>Low Born</label>
		<description>Necrons that hold this gene are genetically imperfect and thus considered lowborn. They do not possess free will and do not have the mental capacity to desire comfort, recreation, or beautiful surroundings.</description>
		<iconPath>Genes/lowborn</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<disablesNeeds>
			<li>Food</li>
			<li>Comfort</li>
			<li>Joy</li>
			<li>Beauty</li>
			<li>Outdoors</li>
			<li>Indoors</li>
		</disablesNeeds>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_GreaterStagger</defName>
		<label>Great Stagger</label>
		<description>. . .</description>
		<iconPath>Genes/greatstagger</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<statFactors>
			<StaggerDurationFactor>1.15</StaggerDurationFactor>
		</statFactors>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_Sharpshooter</defName>
		<label>Sharpshooter</label>
		<description>. . .</description>
		<iconPath>Genes/sharpshooter</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<statFactors>
			<ShootingAccuracyFactor_Long>1.5</ShootingAccuracyFactor_Long>
		</statFactors>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_Workflow</defName>
		<label>Workflow</label>
		<description>. . .</description>
		<iconPath>Genes/workflow</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<statOffsets>
			<WorkSpeedGlobal>0.15</WorkSpeedGlobal>
		</statOffsets>
