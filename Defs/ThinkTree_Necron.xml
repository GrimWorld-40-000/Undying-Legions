<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Injected into the vanilla Humanlike tree via Humanlike_PostMentalState.
       Both givers return null immediately for any pawn that doesn't have the
       relevant ability, so this is safe for all humanlike pawns. -->
  <ThinkTreeDef>
    <defName>GW40K_Deathmark_Phase_Subtree</defName>
    <insertTag>Humanlike_PostMentalState</insertTag>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <!-- Hunter's Mark: 60% chance to mark the current enemy target -->
        <li Class="GW40K_Necrons.JobGiver_DeathmarkHuntersMark"/>
        <!-- Phase: teleport to better cover after taking damage -->
        <li Class="GW40K_Necrons.JobGiver_DeathmarkPhase"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef>
    <defName>GW40K_Necron_ThinkTree</defName>
    <label>Necron thinktree</label>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>

        <!-- Do lovin' -->
        <li Class="ThinkNode_ConditionalLyingDown">
          <subNodes>
            <li Class="ThinkNode_ChancePerHour_Lovin">
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>SatisfyingNeeds</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_DoLovin" />
                  </subNodes>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>
            
        <!-- If we HAVE to keep lying down... -->
        <li Class="ThinkNode_ConditionalMustKeepLyingDown">
          <subNodes>
            <!-- Do a queued job if possible (e.g. watch tv in bed) -->
            <li Class="ThinkNode_QueuedJob">
              <inBedOnly>true</inBedOnly>
            </li>

            <!-- Get joy -->
            <li Class="ThinkNode_Tagger">
              <tagToGive>SatisfyingNeeds</tagToGive>
              <subNodes>
                <li Class="ThinkNode_PrioritySorter">
                  <subNodes>
                    <li Class="ThinkNode_Priority_GetJoy">
                      <subNodes>
                        <li Class="JobGiver_GetJoyInBed" />
                      </subNodes>
                    </li>
                    <li Class="JobGiver_MeditateInBed"/>
                  </subNodes>
                </li>
              </subNodes>
            </li>
            
            <!-- Keep lying down -->
            <li Class="JobGiver_KeepLyingDown" />
          </subNodes>
        </li>
      
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateCritical</treeDef>
        </li>

        <!-- Escaping threats -->
        <li Class="ThinkNode_Subtree" MayRequire="Ludeon.RimWorld.Biotech">
          <treeDef>Abilities_Escape</treeDef>
        </li>
        
        <!-- React to close melee threat -->
        <li Class="JobGiver_ReactToCloseMeleeThreat" />

        <!-- Mental state non critical -->
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateNonCritical</treeDef>
        </li>

        <!-- Behavior when roped -->
        <li Class="ThinkNode_Subtree">
          <treeDef>RopedPawn</treeDef>
        </li>

        <!-- Insertion hook for modders -->
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Humanlike_PostMentalState</insertTag>
        </li>
        
        <!-- Do a queued job -->
        <li Class="ThinkNode_QueuedJob" />

        <!-- Wait if drafted -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>DraftedOrder</tagToGive>
              <subNodes>
                <li Class="JobGiver_MoveToStandable" />
                <li Class="JobGiver_Orders" />
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Self-tend if you're an NPC -->
        <li Class="ThinkNode_ConditionalNPCCanSelfTendNow">
          <subNodes>
            <li Class="JobGiver_SelfTend" />
          </subNodes>
        </li>

        <!-- Lord directives (high priority) — voluntarily-joinable lords (Nechinator). -->
        <li Class="ThinkNode_JoinVoluntarilyJoinableLord">
          <dutyHook>HighPriority</dutyHook>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDuty</treeDef>
            </li>
          </subNodes>
        </li>

        <!-- Direct duty processing for non-voluntarily-joinable lords (siege raid lord).
             ThinkNode_JoinVoluntarilyJoinableLord silently skips LordJob_NecronSiege because
             it does not extend LordJob_VoluntarilyJoinable. This node fires for enemy Necrons
             whose duty was assigned directly by UpdateAllDuties (AssaultColony etc.). -->
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>

        <!-- Insertion hook for modders -->
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Humanlike_PostDuty</insertTag>
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_GetMaintenance"/>
          </subNodes>
        </li>
        <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />
        <li Class="GW40K_Necrons.JobGiver_GaussRechargeFromBattery" />
        <li Class="GW40K_Necrons.JobGiver_GetGaussCore" />
        <!-- Prisoner -->
        <li Class="ThinkNode_ConditionalPrisoner">
          <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
          <subNodes>
            <!-- If it's the player home map... -->
            <li Class="ThinkNode_ConditionalInNonPlayerHomeMap">
              <invert>true</invert>
              <subNodes>
                <!-- Wait instead of escaping if should -->
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_PrisonerWaitInsteadOfEscaping">
                      <maxDanger>Deadly</maxDanger>
                    </li>
                  </subNodes>
                </li>
              
                <!-- Escape -->
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Escaping</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_PrisonerEscape" />
                  </subNodes>
                </li>
              </subNodes>
            </li>
            
            <!-- Exit map if released -->
            <li Class="ThinkNode_ConditionalReleased">
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Misc</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_ExitMapBest">
                      <defaultLocomotion>Walk</defaultLocomotion>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <li Class="ThinkNode_Tagger">
              <tagToGive>RestingForMedicalReasons</tagToGive>
              <subNodes>
                <li Class="JobGiver_PatientGoToBed" />
              </subNodes>
            </li>
            
            <li Class="ThinkNode_Tagger">
              <tagToGive>ChangingApparel</tagToGive>
              <subNodes>
                <li Class="JobGiver_PrisonerGetDressed" />
              </subNodes>
            </li>
            
            <li Class="ThinkNode_Tagger">
              <tagToGive>SatisfyingNeeds</tagToGive>
              <subNodes>
                <li Class="ThinkNode_PrioritySorter">
                  <subNodes>
                    <li Class="JobGiver_Autofeed" MayRequire="Ludeon.RimWorld.Biotech" />
                    <li Class="GW40K_Necrons.JobGiver_GetGaussCore"/>
                    <li Class="GW40K_Necrons.JobGiver_GetMaintenance"/>
                    <li Class="JobGiver_SatisfyChemicalNeed"/>
                    <li Class="JobGiver_SatifyChemicalDependency" MayRequire="Ludeon.RimWorld.Biotech" />
                    <li Class="JobGiver_GetHemogen" MayRequire="Ludeon.RimWorld.Biotech" />
                    <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />
                    <li Class="ThinkNode_Priority_GetJoy">
                      <subNodes>
                        <li Class="JobGiver_GetJoy"/>
                        <li Class="JobGiver_GetJoyInBed"/>
                      </subNodes>
                    </li>
                    <li Class="JobGiver_Meditate"/>
                  </subNodes>
                </li>
              </subNodes>
            </li>
            
            <!-- If in non-PlayerHomeMap -->
            <li Class="ThinkNode_ConditionalInNonPlayerHomeMap">
              <subNodes>
                <!-- No colonist spawned in the map -->
                <li Class="ThinkNode_ConditionalAnyUndownedColonistSpawnedNearby">
                  <invert>true</invert>
                  <subNodes>
                    <li Class="ThinkNode_Tagger">
                      <tagToGive>Escaping</tagToGive>
                      <subNodes>
                        <li Class="JobGiver_PrisonerEscape" />
                      </subNodes>
                    </li>
                  </subNodes>
                </li>
                <!-- Wander -->
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_WanderColony">
                      <maxDanger>Deadly</maxDanger>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>
            
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <li Class="JobGiver_WanderCurrentRoom">
                  <maxDanger>Deadly</maxDanger>
                </li>
              </subNodes>
            </li>
            
            <li Class="JobGiver_IdleError" />
          </subNodes>
        </li>

        <!-- If on colonist team, do forced and emergency work -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <!-- Seek allowed area -->
            <li Class="JobGiver_SeekAllowedArea" />

            <!-- Seek safe temperatures -->
            <li Class="JobGiver_BringBabyToSafety" />
            <li Class="JobGiver_SeekSafeTemperature" />

            <!-- Drop unnused inventory -->
            <li Class="JobGiver_DropUnusedInventory" />

            <!-- Emergency work -->
            <li Class="JobGiver_Work">
              <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
              <emergency>true</emergency>
            </li>
            
            <!-- Emergency gauss core recharge if energy is low -->
            <li Class="ThinkNode_ConditionalStarving">
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>SatisfyingNeeds</tagToGive>
                  <subNodes>
                    <li Class="GW40K_Necrons.JobGiver_GetGaussCore">
                      <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Breastfeed -->
            <li Class="ThinkNode_Tagger">
              <tagToGive>Misc</tagToGive>
              <subNodes>
                <li Class="JobGiver_Autofeed" MayRequire="Ludeon.RimWorld.Biotech" />
              </subNodes>
            </li>

            <!-- Lord directives (medium priority) -->
            <li Class="ThinkNode_JoinVoluntarilyJoinableLord">
              <dutyHook>MediumPriority</dutyHook>
              <subNodes>
                <li Class="ThinkNode_Subtree">
                  <treeDef>LordDuty</treeDef>
                </li>
              </subNodes>
            </li>

            <!-- Pick up a weapon dropped while previously downed -->
            <li Class="JobGiver_PickupDroppedWeapon">
              <ignoreForbidden>true</ignoreForbidden>
            </li>

            <!-- Optimize apparel -->
            <li Class="ThinkNode_Tagger">
              <tagToGive>ChangingApparel</tagToGive>
              <subNodes>
                <li Class="JobGiver_OptimizeApparel">
                  <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
                </li>
              </subNodes>
            </li>

            <!-- Look change -->
            <li MayRequire="Ludeon.RimWorld.Ideology" Class="ThinkNode_ConditionalWantsLookChange">
              <subNodes>
                <li Class="JobGiver_UseStylingStationAutomatic" />
              </subNodes>
            </li>

            <!-- Dye hair -->
            <li MayRequire="Ludeon.RimWorld.Ideology" Class="JobGiver_DyeHair" />

            <!-- Take for inventory stock -->
            <li Class="ThinkNode_Tagger">
              <tagToGive>TakeForInventoryStock</tagToGive>
              <subNodes>
                <li Class="JobGiver_TakeForInventoryStock">
                  <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
                </li>
              </subNodes>
            </li>

            <!-- Unload your inventory -->
            <li Class="ThinkNode_Tagger">
              <tagToGive>UnloadingOwnInventory</tagToGive>
              <subNodes>
                <li Class="JobGiver_UnloadYourInventory" />
              </subNodes>
            </li>

          </subNodes>
        </li>

        <!-- Behavior from traits -->
        <li Class="ThinkNode_TraitBehaviors" />

        <!-- Insertion hook for modders -->
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Humanlike_PreMain</insertTag>
        </li>
        
        <!-- Main colonist behavior core -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>MainColonistBehaviorCore</treeDef>
              <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
            </li>
          </subNodes>
        </li>
        <!-- Main wild man behavior core -->
        <li Class="ThinkNode_ConditionalPawnKind">
          <pawnKind>WildMan</pawnKind>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>MainWildManBehaviorCore</treeDef>
              <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
            </li>
          </subNodes>
        </li>

        <!-- Insertion hook for modders -->
        <li Class="ThinkNode_SubtreesByTag">
          <insertTag>Humanlike_PostMain</insertTag>
        </li>

        <!-- Nech Work Mode: mode-gated idle behaviors for player-faction colonist Necrons.
             Evaluated after main colonist behavior; overrides generic idle wander.
             Enemy Necrons fail the faction check inside ThinkNode_ConditionalNechWorkMode. -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>

            <!-- Patrol: seek and engage enemies, then wander the colony -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Patrol</workMode>
              <subNodes>
                <li Class="JobGiver_AIFightEnemies">
                  <targetAcquireRadius>65</targetAcquireRadius>
                </li>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_WanderColony">
                      <maxDanger>None</maxDanger>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Escort: defend commander, follow, wander near commander -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Escort</workMode>
              <subNodes>
                <li Class="GW40K_Necrons.JobGiver_NechDefendCommander" />
                <li Class="GW40K_Necrons.JobGiver_NechEscortCommander" />
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="GW40K_Necrons.JobGiver_NechWanderCommander" />
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Maintain: seek maintenance/recharge, then wander -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Maintain</workMode>
              <subNodes>
                <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />
                <li Class="GW40K_Necrons.JobGiver_GaussRechargeFromBattery" />
                <li Class="GW40K_Necrons.JobGiver_GetGaussCore" />
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_WanderColony">
                      <maxDanger>None</maxDanger>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Hold: stand at captured position, combat-ready -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Hold</workMode>
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="GW40K_Necrons.JobGiver_NechHoldPosition" />
                  </subNodes>
                </li>
              </subNodes>
            </li>

          </subNodes>
        </li>

        <!-- Idle colonist (fallback when no mode branch fires, or mode has no idle job) -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <!-- Do random joy activity -->
                <li Class="ThinkNode_ConditionalNeedPercentageAbove">
                  <need>Joy</need>
                  <threshold>0.9</threshold>
                  <invert>true</invert>
                  <subNodes>
                    <li Class="JobGiver_IdleJoy" />
                  </subNodes>
                </li>

                <!-- Wander -->
                <li Class="JobGiver_WanderColony">
                  <maxDanger>None</maxDanger>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Idle wild man -->
        <li Class="ThinkNode_ConditionalPawnKind">
          <pawnKind>WildMan</pawnKind>
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <!-- Wander -->
                <li Class="JobGiver_WanderAnywhere">
                  <maxDanger>Deadly</maxDanger>
                  <ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- If you're a neutral guest, if you're not hurt exit the map, otherwise use a medical bed -->
        <li Class="ThinkNode_ConditionalGuest">
          <subNodes>
            <li Class="ThinkNode_ConditionalNonPlayerNonHostileFactionOrFactionless">
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>RestingForMedicalReasons</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_PatientGoToBed" />
                  </subNodes>
                </li>
                
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Misc</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_ExitMapBest">
                      <defaultLocomotion>Walk</defaultLocomotion>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Final backup: If you're just here for no apparent reason, and not a colonist, leave the map
             e.g. This happens for pawns who are downed during combat, then later self-heal -->
        <li Class="ThinkNode_ConditionalColonist">
          <invert>true</invert>
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Misc</tagToGive>
              <subNodes>
                <li Class="JobGiver_ExitMapBest">
                  <defaultLocomotion>Walk</defaultLocomotion>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- If you can't leave, just wander -->
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
            </li>
          </subNodes>
        </li>

        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Stripped think tree for the humanlike Flayed One (GW40K_NecronFlayedOne).
       Removes all humanlike social/work/joy behaviour. Keeps critical responses,
       Nechinator lord duty, Necrodermis maintenance, flesh-seeking, and wandering.
       Vanilla mood breaks are intentionally absent — Dysphorakh episodes are triggered
       directly from C# (HediffCompProperties_DysphorakhEpisodes) and bypass this tree. -->
  <ThinkTreeDef>
    <defName>GW40K_FlayedOne_ThinkTree</defName>
    <label>Flayed One think tree</label>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>

        <!-- Downed -->
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <!-- Burning panic -->
        <li Class="ThinkNode_Subtree">
          <treeDef>BurningResponse</treeDef>
        </li>
        <!-- Critical mental states (fire panic, etc.) only — NOT MentalStateNonCritical. -->
        <li Class="ThinkNode_Subtree">
          <treeDef>MentalStateCritical</treeDef>
        </li>
        <!-- Escape abilities (Biotech) -->
        <li Class="ThinkNode_Subtree" MayRequire="Ludeon.RimWorld.Biotech">
          <treeDef>Abilities_Escape</treeDef>
        </li>
        <!-- React to close melee threat -->
        <li Class="JobGiver_ReactToCloseMeleeThreat" />
        <!-- Queued job (drafted orders from Nechinator) -->
        <li Class="ThinkNode_QueuedJob" />
        <!-- Draft + attack orders when commanded -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>DraftedOrder</tagToGive>
              <subNodes>
                <li Class="JobGiver_MoveToStandable" />
                <li Class="JobGiver_Orders" />
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- High-priority Nechinator lord duty (formation, attack target, etc.) -->
        <li Class="ThinkNode_JoinVoluntarilyJoinableLord">
          <dutyHook>HighPriority</dutyHook>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDuty</treeDef>
            </li>
          </subNodes>
        </li>

        <!-- Necrodermis maintenance -->
        <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />

        <!-- Flesh-seek (pre-starvation corpse/meat scavenge) and flesh-hunt (living prey) -->
        <li Class="GW40K_Necrons.JobGiver_FlayedOneFleshSeek" />

        <!-- Starvation fallback — GetFood with FoodType gating -->
        <li Class="ThinkNode_ConditionalStarving">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>SatisfyingNeeds</tagToGive>
              <subNodes>
                <li Class="JobGiver_GetFood">
                  <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Medium-priority Nechinator lord duty -->
        <li Class="ThinkNode_JoinVoluntarilyJoinableLord">
          <dutyHook>MediumPriority</dutyHook>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>LordDuty</treeDef>
            </li>
          </subNodes>
        </li>

        <!-- Allowed area constraint -->
        <li Class="JobGiver_SeekAllowedArea" />

        <!-- Exit the map if not a colonist (e.g. released prisoner conversion) -->
        <li Class="ThinkNode_ConditionalColonist">
          <invert>true</invert>
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Misc</tagToGive>
              <subNodes>
                <li Class="JobGiver_ExitMapBest">
                  <defaultLocomotion>Walk</defaultLocomotion>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>

        <!-- Nech Work Mode: mode-gated idle behaviors for player-faction Flayed Ones.
             Flesh-seeking at high priority remains unaffected (it fires before this section). -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>

            <!-- Patrol: seek enemies, then wander colony -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Patrol</workMode>
              <subNodes>
                <li Class="JobGiver_AIFightEnemies">
                  <targetAcquireRadius>65</targetAcquireRadius>
                </li>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_WanderColony">
                      <maxDanger>None</maxDanger>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Escort: defend commander, follow, wander near commander -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Escort</workMode>
              <subNodes>
                <li Class="GW40K_Necrons.JobGiver_NechDefendCommander" />
                <li Class="GW40K_Necrons.JobGiver_NechEscortCommander" />
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="GW40K_Necrons.JobGiver_NechWanderCommander" />
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Maintain: seek maintenance, then wander -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Maintain</workMode>
              <subNodes>
                <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="JobGiver_WanderColony">
                      <maxDanger>None</maxDanger>
                    </li>
                  </subNodes>
                </li>
              </subNodes>
            </li>

            <!-- Hold: stand at captured position, combat-ready -->
            <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
              <workMode>GW40K_NechMode_Hold</workMode>
              <subNodes>
                <li Class="ThinkNode_Tagger">
                  <tagToGive>Idle</tagToGive>
                  <subNodes>
                    <li Class="GW40K_Necrons.JobGiver_NechHoldPosition" />
                  </subNodes>
                </li>
              </subNodes>
            </li>

          </subNodes>
        </li>

        <!-- Idle: wander the colony when colonist (fallback for all modes) -->
        <li Class="ThinkNode_ConditionalColonist">
          <subNodes>
            <li Class="ThinkNode_Tagger">
              <tagToGive>Idle</tagToGive>
              <subNodes>
                <li Class="JobGiver_WanderColony">
                  <maxDanger>None</maxDanger>
                </li>
              </subNodes>
            </li>
          </subNodes>
        </li>
        <!-- Idle fallback: wander anywhere -->
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="JobGiver_WanderAnywhere">
              <maxDanger>Deadly</maxDanger>
            </li>
          </subNodes>
        </li>

        <li Class="JobGiver_IdleError" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <ThinkTreeDef>
    <defName>GW40K_ScarabSwarm</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <!-- Sapper raids: tunnel toward sapperDest (mine rock; self-destruct constructed walls). -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalSapperDuty">
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_ScarabSapper" />
          </subNodes>
        </li>
        <!-- Breach raids: leap over walls and kamikaze detonate on adjacent walls.
             JobGiver_AIAbilityFight removed — it explicitly named GW40K_ScarabLeap
             bypassing aiCanUse=false, issuing redundant leap jobs that cancelled the
             one from JobGiver_ScarabLeapOverWall and looped. -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalBreachingDuty">
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_ScarabLeapOverWall" />
            <li Class="GW40K_Necrons.JobGiver_ScarabBreachDetonate" />
          </subNodes>
        </li>
        <!-- Repair mode: self first, then structures; friendly Necron pawn repair is reserved for a later pass. -->
        <li Class="GW40K_Necrons.JobGiver_CanoptekRepair" />
        <!-- Consume mode: harvest necrodermis from approved map resources when idle -->
        <li Class="GW40K_Necrons.JobGiver_CanoptekConsume" />
        <!-- Work mode: haul, mine, and construct for the colony -->
        <li Class="GW40K_Necrons.JobGiver_CanoptekWork" />
        <!-- Produce mode: pump necrodermis to Spyder HiveFabricator or self-reproduce -->
        <li Class="GW40K_Necrons.JobGiver_ScarabProduce" />
        <!-- Defend mode: follow nearest allied Necron humanlike controller -->
        <li Class="GW40K_Necrons.JobGiver_ScarabDefendController" />
        <!-- All standard animal behavior: combat, wandering, faction duty, fleeing -->
        <li Class="ThinkNode_Subtree">
          <treeDef>Animal</treeDef>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>


  <!-- Think tree for the Canoptek Spyder.
       Runs JobGiver_SpyderRaidStandoff first: for hostile non-siege Spyders it overrides
       the pawn's duty to GW_UL_SpyderRaidStandoff (standoff ~17 tiles from colony) and
       returns null, so the Mechanoid subtree below processes the job normally using that duty.
       For player-faction Spyders or those in LordJob_NecronSiege it is a no-op pass-through.
       The full Mechanoid subtree handles combat, downed response, wandering, etc. -->
  <ThinkTreeDef>
    <defName>GW_UL_SpyderThinkTree</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>

        <!-- Enemy Spyder standoff: for non-player, non-siege Spyders overrides duty to a
             standoff position. For player Spyders this is a no-op pass-through. -->
        <li Class="GW40K_Necrons.JobGiver_SpyderRaidStandoff" />

        <!-- Nech Work Mode: mode-gated behavior for player-faction Spyders.
             Enemy Spyders fail the faction check and fall through to Mechanoid. -->

        <!-- Work: repair first, then let Mechanoid handle hauling / wandering -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
          <workMode>GW40K_NechMode_Work</workMode>
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_CanoptekRepair" />
            <!-- Hauling/construction fall through to Mechanoid subtree below -->
          </subNodes>
        </li>

        <!-- Patrol: engage enemies, then let Mechanoid handle wandering -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
          <workMode>GW40K_NechMode_Patrol</workMode>
          <subNodes>
            <li Class="JobGiver_AIFightEnemies">
              <targetAcquireRadius>65</targetAcquireRadius>
            </li>
          </subNodes>
        </li>

        <!-- Escort: defend commander, follow -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
          <workMode>GW40K_NechMode_Escort</workMode>
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_NechDefendCommander" />
            <li Class="GW40K_Necrons.JobGiver_NechEscortCommander" />
            <li Class="GW40K_Necrons.JobGiver_NechWanderCommander" />
          </subNodes>
        </li>

        <!-- Maintain: seek maintenance, then wander via Mechanoid fallthrough -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
          <workMode>GW40K_NechMode_Maintain</workMode>
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_GetMaintenance" />
          </subNodes>
        </li>

        <!-- Hold: stand at captured position, combat-ready -->
        <li Class="GW40K_Necrons.ThinkNode_ConditionalNechWorkMode">
          <workMode>GW40K_NechMode_Hold</workMode>
          <subNodes>
            <li Class="GW40K_Necrons.JobGiver_NechHoldPosition" />
          </subNodes>
        </li>

        <!-- Standard Mechanoid behavior: downed, combat, wandering for all Spyders -->
        <li Class="ThinkNode_Subtree">
          <treeDef>Mechanoid</treeDef>
        </li>

      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
