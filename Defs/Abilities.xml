<Defs>
	<AbilityDef>
		<defName>GW40K_Deathmark_HuntersMark</defName>
		<label>hunter's mark</label>
		<description>The Deathmark selects a target for termination. An emerald energy brand is seared into the victim â€” a halo of cold light visible even through stone and steel. For one hour the marked target cannot hide â€” the Deathmark's will track them with uncanny precision.</description>
		<iconPath>UI/Abilities/GW40k_DeathmarkHunt</iconPath>
		<cooldownTicksRange>30000</cooldownTicksRange><!-- 12 hours -->
		<aiCanUse>true</aiCanUse>
		<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
		<sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>24.9</range>
			<warmupTime>1.5</warmupTime>
			<soundCast>PsychicShockLanceCast</soundCast>
			<targetParams>
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>true</canTargetPawns>
				<canTargetAnimals>true</canTargetAnimals>
				<canTargetSelf>false</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
