<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Carbon copy of MechanitorImplantBase — no vanilla inheritance -->
  <ThingDef Abstract="True" Name="NecImplantBase">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <techLevel>Archotech</techLevel>
    <useHitPoints>true</useHitPoints>
    <pathCost>14</pathCost>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Never</tickerType>
    <alwaysHaulable>true</alwaysHaulable>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <thingCategories>
      <li>BodyPartsMechtech</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <!-- Item: Command Protocol node (equippable, installs the hediff) -->
  <ThingDef ParentName="NecImplantBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>GW40K_CommandProtocol</defName>
    <label>command protocol</label>
    <description>An ancient Necron cranial node that encodes hard-wired dominance directives into the bearer's neural engrams, allowing direct command over Necron war constructs. Those who bear the command protocol are known as Necron Overlords.\n\nThe node is self-installing. Pressed against the base of the skull, it fuses with the living metal of the host's nervous system and threads command-band frequencies through the necrodermis framework.\n\nUnlike crude mechanoid links, the command protocol does not merely send radio signals — it enforces the absolute unity and obedience of the Necron race through hard-coded directives etched sixty million years ago. The bond between Overlord and construct is not cooperation; it is compulsion.\n\nThe protocol is integrated at the core engram level and cannot be removed while the bearer lives.\n\nNote: A bearer of the command protocol must be capable of smithing work to gestate Necron constructs.</description>
    <descriptionHyperlinks><HediffDef>GW40K_CommandProtocolImplant</HediffDef></descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>1</Mass>
      <MarketValue>1500</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Mechlink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.65</drawSize>
      <color>(168, 211, 160)</color>
    </graphicData>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>GW40K_CommandProtocolImplant</hediffDef>
        <bodyPart>Head</bodyPart>
        <requiresPsychicallySensitive>false</requiresPsychicallySensitive>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>MechlinkInstalled</soundOnUsed>
      </li>
    </comps>
  </ThingDef>

  <!-- Item: Control Node (equippable, installs the hediff) -->
  <ThingDef ParentName="NecImplantBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>GW40K_ControlNode</defName>
    <label>control node</label>
    <description>An ancient Necron transmitter that allows the user to interface with Canoptek constructs through interstitial carrier waves — undetectable, cross-dimensional signals that transmit commands.</description>
    <descriptionHyperlinks><HediffDef>GW40K_ControlNodeImplant</HediffDef></descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>1</Mass>
      <MarketValue>1500</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponSpecial/OrbitalTargeter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.65</drawSize>
      <color>(168, 211, 160)</color>
    </graphicData>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>GW40K_ControlNodeImplant</hediffDef>
        <bodyPart>Head</bodyPart>
        <requiresPsychicallySensitive>false</requiresPsychicallySensitive>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>MechlinkInstalled</soundOnUsed>
      </li>
    </comps>
  </ThingDef>

  <!-- Hediff: installed command protocol -->
  <HediffDef ParentName="ImplantHediffBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>GW40K_CommandProtocolImplant</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>command protocol</label>
    <description>An ancient Necron cranial node that encodes hard-wired dominance directives into the bearer's neural engrams, allowing direct command over Necron war constructs.\n\nThe absolute unity and obedience of the Necron race, enforced through directives etched sixty million years ago. Cannot be removed while the bearer lives.</description>
    <descriptionShort>A Necron cranial node that allows direct command over Necron war constructs. Cannot be removed while the bearer lives.</descriptionShort>
    <isBad>false</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <comps>
      <li Class="GW40K_Necrons.HediffCompProperties_NecronCommand">
        <bandwidthMax>6</bandwidthMax>
        <!-- Fallback when extension omits commandBandwidthCost; per-race overrides on ThingDef modExtension. -->
        <bandwidthCostPerMech>1</bandwidthCostPerMech>
        <controlRange>20</controlRange>
      </li>
      <!-- Command Protocol is fused to the bearer — no removable mechlink notification on death
      <li Class="HediffCompProperties_LetterOnDeath">
        <letterDef>NeutralEvent</letterDef>
        <letterLabel>Reusable {HEDIFF_label} available</letterLabel>
        <letterText>{PAWN} has died with a {HEDIFF_label} installed. This can be removed and installed by someone else.</letterText>
        <onlyIfNoMechanitorDied>true</onlyIfNoMechanitorDied>
      </li>
      -->
    </comps>
  </HediffDef>

  <!-- Hediff: installed control node -->
  <HediffDef ParentName="ImplantHediffBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>GW40K_ControlNodeImplant</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>control node</label>
    <description>An ancient Necron transmitter that allows the bearer to interface with Canoptek constructs through interstitial carrier waves — undetectable, cross-dimensional signals that transmit commands. Cannot be removed while the bearer lives.</description>
    <descriptionShort>An ancient Necron command-relay implant integrated into the skull.</descriptionShort>
    <isBad>false</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <comps>
      <li Class="GW40K_Necrons.HediffCompProperties_ControlNode">
        <standardBandwidthMax>3</standardBandwidthMax>
        <cryptekBandwidthMax>4</cryptekBandwidthMax>
        <spyderBandwidthMax>6</spyderBandwidthMax>
        <bandwidthCostPerScarab>1</bandwidthCostPerScarab>
        <controlRange>20</controlRange>
      </li>
    </comps>
  </HediffDef>

  <!-- ── Sentience Catalyst ─────────────────────────────────────────────────── -->

  <!-- Item: self-installing, installs the hediff on use -->
  <ThingDef ParentName="NecImplantBase">
    <defName>GW40K_SentienceCatalyst</defName>
    <label>sentience catalyst</label>
    <description>An archeotech crystalline lattice that re-routes higher-cognitive pathways through the bearer's mind core, elevating base-tier Necron soldiers above their factory-issue programming.\n\nInserted directly into the mind core. The bearer's combat engrams expand to encompass the full spectrum of weapons — not merely the gauss-pattern arms they were built to wield.</description>
    <descriptionHyperlinks><HediffDef>GW40K_SentienceCatalystImplant</HediffDef></descriptionHyperlinks>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.5</Mass>
      <MarketValue>1200</MarketValue>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <!-- Vanilla 1.6 Core: neuroformer art (old PsychicAmplifier path removed). -->
      <texPath>Things/Item/Special/PsylinkNeuroformer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.65</drawSize>
      <color>(140, 190, 255)</color>
    </graphicData>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <compClass>CompUsableImplant</compClass>
        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffectInstallImplant">
        <hediffDef>GW40K_SentienceCatalystImplant</hediffDef>
        <bodyPart>GW40K_Necron_MindCore</bodyPart>
        <requiresPsychicallySensitive>false</requiresPsychicallySensitive>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>MechlinkInstalled</soundOnUsed>
      </li>
    </comps>
  </ThingDef>

  <!-- Hediff: granted on installation -->
  <HediffDef ParentName="ImplantHediffBase">
    <defName>GW40K_SentienceCatalystImplant</defName>
    <hediffClass>Hediff_Implant</hediffClass>
    <label>sentience catalyst</label>
    <description>This Necron has distinguished itself and has been granted a higher sentience, allowing them to equip a wider range of weapons.</description>
    <isBad>false</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <stages>
      <li/>
    </stages>
  </HediffDef>

</Defs>
