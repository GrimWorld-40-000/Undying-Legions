  <RulePackDef>
    <defName>NamerSettlementFlayedOne</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->The [adj] [place]</li>
        <li>r_name->[place] of [name]</li>
        <li>r_name->The [place] of [name]</li>

        <li>adj->Charnel</li>
        <li>adj->Flesh-strewn</li>
        <li>adj->Haunted</li>
        <li>adj->Cursed</li>
        <li>adj->Blighted</li>
