<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Inject Necron auto-attack into the vanilla HumanlikeConstant constant think tree.
       Inserted after JoinAutoJoinableCaravan so it fires before ConfigurableHostilityResponse.
       JobGiver_NecronAutoAttack returns null immediately for any pawn without NonOrganicPawn,
       so vanilla colonists and all non-Necron humanlike pawns are entirely unaffected. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="HumanlikeConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="ThinkNode_Subtree"][treeDef="JoinAutoJoinableCaravan"]</xpath>
    <order>Append</order>
    <value>
      <li Class="GW40K_Necrons.JobGiver_NecronAutoAttack" />
    </value>
  </Operation>

</Patch>
