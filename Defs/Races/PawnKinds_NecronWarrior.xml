<Defs>
    <!-- Necron Warrior Colonist-based Pawn -->
    <PawnKindDef ParentName="GW40K_NecronWarriorPawnKind">
        <defName>GW40K_NecronWarriorPawnKind_Colonist</defName>
        <label>necron warrior</label>
        <lifeStages>
          <li>
            <bodyGraphicData>
              <drawSize>1.0</drawSize>
            </bodyGraphicData>
          </li>
        </lifeStages>
        <defaultFactionType>PlayerColony</defaultFactionType>
        <race>GW40K_NecronWarrior</race>
        <combatPower>120</combatPower>
        <!-- Always spawn with Gauss Flayer/Reaper -->
        <weaponMoney>3000~4000</weaponMoney>
        <weaponTags>
          <li>GW_Necron_GaussFlayer</li>
          <li>GW_Necron_GaussReaper</li>
        </weaponTags>
        <!-- No apparel — Warrior is Nech-controlled and wears nothing but trophied flesh. -->
        <apparelTags Inherit="False" />
        <apparelMoney>0</apparelMoney>
        <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
        <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
        <backstoryFiltersOverride>
          <li>
            <categories>
              <li>NecronWarrior</li>
              <li>NecronLowborn</li>
            </categories>
          </li>
        </backstoryFiltersOverride>
        <techHediffsChance>0.00</techHediffsChance> <!--Disabled - default 0.03 -->
        <techHediffsMoney>0</techHediffsMoney> <!--Disabled - default 50~800 -->
        <techHediffsTags>
          <li>Poor</li>
          <li>Simple</li>
          <li>ImplantEmpireCommon</li>
        </techHediffsTags>
        <techHediffsDisallowTags>
          <li>PainCauser</li>
        </techHediffsDisallowTags>
        <initialResistanceRange>13~21</initialResistanceRange>
        <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
          <xenotypeChances>
            <GW_UD_NecronWarrior>1</GW_UD_NecronWarrior>
          </xenotypeChances>
        </xenotypeSet>
      </PawnKindDef>
</Defs>