<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Replaces vanilla BloodLoss for any pawn whose bloodDef is GW40K_Filth_NecronBlood.
       HarmonyPatch_RedirectBloodLossToFluxLoss redirects HealthUtility.AdjustSeverity so
       this accumulates instead of BloodLoss. Stage thresholds and capMods are identical to
       vanilla BloodLoss — only the labels and description differ. -->
  <HediffDef>
    <defName>GW40K_CoreFluxLoss</defName>
    <label>core flux leak</label>
    <description>Core flux — the living energy that animates Necron living metal — is draining from breached structural conduits. Minor leakage has limited effect, but sustained loss degrades engram coherence and motive power. Catastrophic flux drain leads to total systemic shutdown.\n\nFlux loss gradually self-seals as the living metal rewrites damaged conduits.</description>
    <lethalSeverity>1</lethalSeverity>
    <defaultLabelColor>(0.7, 0.87, 0.67)</defaultLabelColor>
    <stages>
      <li>
        <label>minor</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>minor</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.30</minSeverity>
        <label>moderate</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>severe</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.60</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- DeathrestExhaustion analogue: applied when GW40K_CoreFlux hits empty (see MaintenanceNeed). -->
  <HediffDef>
    <defName>GW40K_CoreFluxExhaustion</defName>
    <label>core flux exhaustion</label>
    <description>Core flux has collapsed. Engrams stutter and motive power fails until the body enters a full recharge cycle in stasis or deathrest.</description>
    <hediffClass>Hediff</hediffClass>
    <defaultLabelColor>(0.9, 1.0, 0.35)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
        <statOffsets>
          <PsychicSensitivity>-1</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Emergency coma when flux is fully depleted; clears when flux rises above zero. -->
  <HediffDef>
    <defName>GW40K_EternalSlumberForced</defName>
    <label>Eternal Slumber</label>
    <description>With no core flux remaining, the dynastic protocols have forced total shutdown. The Necron lies inert like the sleepers of the tomb worlds until power returns.\n\nEnding Eternal Slumber any way other than a full recovery (core flux restored or safe recharge in stasis/deathrest) shatters the protocol — expect murderous rage toward nearby allies.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(149, 189, 252)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="GW40K_Necrons.HediffCompProperties_EternalSlumberInterruption" />
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
