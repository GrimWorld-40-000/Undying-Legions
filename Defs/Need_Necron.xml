<Defs>
    <NeedDef>
        <defName>GW40K_CoreFlux</defName>
        <needClass>GW40K_Necrons.MaintenanceNeed</needClass>
        <label>core flux</label>
        <description>Necrons must periodically replenish their core flux — the luminescent energy that powers their living metal body. Without it, a Necron's necrodermis shell and neural engrams begin to degrade.\n\nCore flux can be restored by consuming necrodermis, undergoing scarab repair, or entering a stasis crypt.\n\nGoing too long without replenishing core flux will cause the Necron to enter reanimation protocol.</description>
        <onlyIfCausedByGene>true</onlyIfCausedByGene>
        <listPriority>50</listPriority>
        <major>true</major>
        <showForCaravanMembers>true</showForCaravanMembers>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <showUnitTicks>false</showUnitTicks>
      </NeedDef>
	  
    <NeedDef>
        <defName>GW_UD_Necrodermis</defName>
        <needClass>NecronGeneUtil.Need_Necrodermis</needClass>
        <label>necrodermis</label>
        <description>d.</description>
		<onlyIfCausedByGene>true</onlyIfCausedByGene>
		<listPriority>800</listPriority>
        <major>true</major>
        <showForCaravanMembers>true</showForCaravanMembers>
		<fallPerDay>0.15</fallPerDay>
		<modExtensions>
			<li Class="NecronGeneUtil.NeedExtension_Necron">
				<starvingHediffDef>GW_UD_NecrodermisStarving</starvingHediffDef>
				<severityPerInterval>0.01</severityPerInterval>
			</li>
		</modExtensions>
      </NeedDef>
</Defs>