<Defs>
<ThingDef ParentName="BenchBase">
    <defName>GW_UD_Monolith</defName>
    <label>monolith</label>
    <description>WIP.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableSmithingElectric</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <shadowData>
        <volume>(2.8, 0.35, 0.59)</volume>
        <offset>(0, 0, 0.08)</offset>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <constructEffect>ConstructWood</constructEffect>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-3</Cleanliness>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <uiOrder>2519</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>210</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>4</heatPerSecond>
      </li>

        </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Smithing</li>
      <li>Electricity</li>
    </researchPrerequisites>

    </ThingDef>

  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>GW40K_StasisCrypt</defName>
    <label>stasis crypt</label>
    <description>A sealed sarcophagus of ancient living metal, designed to suspend a Necron warrior in a state of total death-like dormancy. While the occupant lies inert, nanotechnic repair arrays embedded within the casing slowly mend damage and replenish the body's necrodermis, restoring the warrior to full fighting readiness. Necron tomb worlds are riddled with millions of such crypts, their contents slumbering undisturbed for sixty million years — waiting for the stars to align once more.\n\nOnly those with the Eternal Slumber gene can use this structure.</description>
    <thingClass>GW40K_Necrons.NecronCasket</thingClass>
    <tickerType>Normal</tickerType>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.5</fillPercent>
    <pathCost>42</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <graphicData>
      <texPath>Things/Building/Ship/ShipCryptosleepCasket</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
      <color>(168, 211, 160)</color>
      <shadowData>
        <volume>(0.83, 0.3, 1.7)</volume>
      </shadowData>
    </graphicData>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2050</uiOrder>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>3200</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Mass>50</Mass>
    </statBases>
    <size>(1,2)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(1,0,0)</interactionCellOffset>
    <costList>
      <Steel>180</Steel>
      <Uranium>5</Uranium>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <idlePowerDraw>0</idlePowerDraw>
        <alwaysDisplayAsUsingPower>true</alwaysDisplayAsUsingPower>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_EmptyStateGraphic">
        <graphicData>
          <texPath>Things/Building/Ship/ShipCryptosleepCasketOpenDoor</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1,2)</drawSize>
          <color>(168, 211, 160)</color>
        </graphicData>
        <!-- Same as vanilla CryptosleepCasket: base stays drawn, open-door graphic layers on top when empty. -->
        <alwaysDrawParent>true</alwaysDrawParent>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Cryptosleep</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_ContentsCasket</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

</Defs>