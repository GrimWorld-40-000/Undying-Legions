<Defs>

	<ThingDef ParentName="ResourceBase">
		<defName>GW40k_Necron_Component</defName>
		<label>black component</label>
		<description>A living metal technilogical component that is used by Necrons to create advanced equipment.</description>
		<graphicData>
			<texPath>Things/Items/Component</texPath>
			<graphicClass>GW40K_Necrons.Graphic_StackCountExact</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>50</stackLimit>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<MarketValue>32</MarketValue>
			<Mass>0.6</Mass>
			<Flammability>0.6</Flammability>
			<DeteriorationRate>2.0</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<allowedArchonexusCount>10</allowedArchonexusCount>
	</ThingDef>
	
	<StuffCategoryDef>
    <defName>Metallic_Necron</defName>
    <label>necron</label>
    <noun>necron</noun>
    <destroySoundSmall>BuildingDestroyed_Metal_Small</destroySoundSmall>
    <destroySoundMedium>BuildingDestroyed_Metal_Medium</destroySoundMedium>
    <destroySoundLarge>BuildingDestroyed_Metal_Big</destroySoundLarge>
  </StuffCategoryDef>
	
	<!-- Raw necrodermis: listed with steel (ResourcesRaw). Necrons refill GW_UD_Necrodermis via CompUsable, not ingestible. -->
	<ThingDef ParentName="ResourceBase">
		<defName>GW40k_Necron_Necrodermis</defName>
		<label>necrodermis</label>
		<description>A viscous "living metal" sludge of nanites. Most see it only as a construction material; Necrons with a necrodermis core can metabolize stacks of it directly.</description>
		<graphicData>
			<texPath>Things/Items/Necrodermis</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Metal_Drop</soundDrop>
		<useHitPoints>false</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MarketValue>8.0</MarketValue>
			<Mass>0.025</Mass>
			<StuffPower_Armor_Sharp>0.9</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.45</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.60</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
			<SharpDamageMultiplier>1</SharpDamageMultiplier>
			<BluntDamageMultiplier>1</BluntDamageMultiplier>
		</statBases>
		<stuffProps>
			<categories>
				<li>Metallic_Necron</li>
			</categories>
			<appearance>Metal</appearance>
			<commonality>1.00</commonality>
			<constructEffect>ConstructMetal</constructEffect>
			<color>(105,105,105)</color>
			<soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
			<soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
			<soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
			<soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
			<statFactors>
				<MaxHitPoints>1</MaxHitPoints>
				<Beauty>1</Beauty>
				<Flammability>0.4</Flammability>
			</statFactors>
			<canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
		</stuffProps>
		<thingCategories>
			<li>ResourcesRaw</li>
		</thingCategories>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<allowedArchonexusCount>150</allowedArchonexusCount>
		<comps>
			<!-- Plague: old ingestible outcome doer plus HediffAura comp — re-enable in git history if desired. -->
			<li Class="NecronGeneUtil.CompProperties_UsableNecrodermisPack">
				<useJob>UseItem</useJob>
				<useLabel>Metabolize necrodermis</useLabel>
				<useDuration>450</useDuration>
				<showUseGizmo>true</showUseGizmo>
			</li>
			<li Class="NecronGeneUtil.CompProperties_UseEffectNecrodermisPackConsume">
				<!-- Must match NecronStasisSettingsDef necrodermisNutritionPerConsumedUnit (stasis crypt fuel math). -->
				<nutritionPerUnit>0.05</nutritionPerUnit>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>GW_NecrodermisInjector</defName>
		<label>necrodermis injector</label>
		<description>A pressurized syringe containing a necrodermis seed suspended in a nutrient solution. Upon injection, the nanites immediately begin rewriting the host's genetic code to support living metal growth. This process is difficult to reverse and ultimately fatal.</description>
    <graphicData>
		<!-- Using MechSerumHealer texture with dark tint to differentiate from the standard serum -->
		<texPath>Things/Item/Special/MechSerumHealer</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		<color>(168, 211, 160)</color>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
		<MarketValue>800</MarketValue>
		<Mass>0.1</Mass>
		<!-- Used by Thing.Ingested / nutrition-aligned refill (one strong dose) -->
		<Nutrition>0.9</Nutrition>
    </statBases>
    <techLevel>Ultra</techLevel>
    <ingestible>
		<foodType>OmnivoreAnimal</foodType>
		<preferability>NeverForNutrition</preferability>
		<outcomeDoers>
			<!-- Growth seed for organics only; Necrons with GW_UD_Necrodermis skip (handled by nutrition on use) -->
			<li Class="NecronMod.IngestionOutcomeDoer_GiveHediffUnlessNeedPresent">
				<hediffDef>Necron_NecrodermisGrowth</hediffDef>
				<severity>0.1</severity>
				<skipIfPawnHasNeed>GW_UD_Necrodermis</skipIfPawnHasNeed>
			</li>
			<!-- Mood for humanlikes; colonization is the growth hediff above (no separate raw-ingest roll) -->
			<li Class="NecronMod.IngestionOutcomeDoer_HumanRawNecrodermis">
				<thoughtDef>GW_UD_IngestedRawNecrodermis</thoughtDef>
				<colonizationChance>0</colonizationChance>
				<skipIfHasNeed>GW_UD_Necrodermis</skipIfHasNeed>
			</li>
		</outcomeDoers>
    </ingestible>
    <comps>
		<li Class="NecronGeneUtil.CompProperties_UsableNecrodermisInjector">
			<useJob>UseItem</useJob>
			<useLabel>Inject necrodermis seed</useLabel>
			<useDuration>600</useDuration>
			<showUseGizmo>true</showUseGizmo>
		</li>
		<li Class="CompProperties_UseEffect">
			<compClass>NecronGeneUtil.CompUseEffect_NecrodermisInjectorIngest</compClass>
		</li>
		<li Class="CompProperties_UseEffectPlaySound">
			<soundOnUsed>MechSerumUsed</soundOnUsed>
		</li>
    </comps>
	</ThingDef>

	<!-- Gauss Core: injectable item that replenishes gauss energy.
	     Stacks in 4. Each use adds exactly 90 raw energy units regardless of capacitor size
	     (delta = 90 / capacity, so 90/100 for small, 90/250 for large).
	     Uses MechSerumUsed sound instead of the standard Ingest_Injectable needle sound. -->
	<ThingDef ParentName="ResourceBase">
		<defName>GW40K_GaussCore</defName>
		<label>gauss core</label>
		<description>A compact archeotech cell charged with particle energy that is designed couple with gauss capacitors. This unit is inserted in the capacitor housing, replenishing the user's gauss energy reserves.\n\nThis cell is rendered useless after charging — each core is single-use.</description>
		<graphicData>
			<texPath>Things/Items/GaussRecharger</texPath>
			<graphicClass>GW40K_Necrons.Graphic_StackCountExact</graphicClass>
		</graphicData>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<stackLimit>4</stackLimit>
		<statBases>
			<MarketValue>300</MarketValue>
			<Mass>0.3</Mass>
			<MaxHitPoints>40</MaxHitPoints>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
		<techLevel>Archotech</techLevel>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Usable">
				<compClass>GW40K_Necrons.CompUsable_GaussCoreOnly</compClass>
				<useJob>GW40K_Job_ConsumeGaussCore</useJob>
				<useLabel>Siphon gauss core</useLabel>
				<useDuration>60</useDuration>
				<showUseGizmo>true</showUseGizmo>
			</li>
			<li Class="GW40K_Necrons.CompProperties_UseEffectGaussCoreConsume" />
			<li Class="CompProperties_UseEffectPlaySound">
				<soundOnUsed>MechSerumUsed</soundOnUsed>
			</li>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>2.9</explosiveRadius>
				<explosiveDamageType>GW40K_GaussCoreBlast</explosiveDamageType>
				<explosiveExpandPerStackcount>0.4</explosiveExpandPerStackcount>
				<startWickHitPointsPercent>0.7</startWickHitPointsPercent>
				<wickTicks>30~60</wickTicks>
				<preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
			</li>
		</comps>
		<tradeability>Sellable</tradeability>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
	</ThingDef>

	<!-- Artifact item: single-use Mindshackle Scarabs worn in the Overlord's exclusive Artifact slot.
	     Grants GW40k_MindshackleArtifact ability; the ability destroys this item on cast. -->
	<ThingDef ParentName="ApparelBase">
		<defName>GW40k_MindshackleScarabsArtifact</defName>
		<thingClass>GW40K_Necrons.MindshackleArtifactApparel</thingClass>
		<label>Mindshackle Scarabs</label>
		<description>An Archeotech capsule of Mindshackle Scarabs — dormant nanomachines suspended in a magnetic field, coiled to launch on command. A Necron Overlord can slot this into their artifact housing and unleash a single wave of scarabs at a target, burrowing into the brain stem to claim ownership of the victim.\n\nSingle use. The capsule is consumed on activation.\n\n&lt;color=#E5A04C&gt;Artifact&lt;/color&gt;</description>
		<graphicData>
			<texPath>Things/Items/ArtifactScarab</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(255, 255, 255)</color>
		</graphicData>
		<rotatable>false</rotatable>
		<techLevel>Archotech</techLevel>
		<smeltable>false</smeltable>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<MarketValue>1200</MarketValue>
			<Mass>0.2</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<EquipDelay>1.0</EquipDelay>
		</statBases>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<layers>
				<li>GW40K_Artifact</li>
			</layers>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
		</apparel>
		<!-- ability granted via MindshackleArtifactApparel.Notify_Worn / Notify_Unequipped -->
		<tradeability>None</tradeability>
		<destroyOnDrop>false</destroyOnDrop>
	</ThingDef>

	<!-- ===== Gauss Capacitor Pack ===== -->

	<ThingDef ParentName="ApparelBase">
		<defName>GW40K_GaussCapacitorPack</defName>
		<label>gauss capacitor pack</label>
		<description>A compact gauss particle-energy matrix housed in a wearable back-pack harness. Recovered or reverse-engineered from Necron technology, this device stores a reservoir of gauss energy, allowing the wearer to operate Archeotech gauss weapons without an integrated capacitor.\n\nThe pack charges from power grid batteries and discharges slowly over time. It does not support core-flux conversion — only Necrons with biological cores can utilise that process.</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/FirefoamPack/FirefoamPack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(168, 228, 160)</color>
		</graphicData>
		<techLevel>Archotech</techLevel>
		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>80</MaxHitPoints>
			<Mass>3</Mass>
			<Flammability>0.4</Flammability>
			<MarketValue>1200</MarketValue>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/FirefoamPack/FirefoamPack</wornGraphicPath>
			<wornGraphicData>
				<renderUtilityAsPack>true</renderUtilityAsPack>
				<north>
					<offset>(0,-0.15)</offset>
				</north>
				<south>
					<offset>(0,0.1)</offset>
					<scale>(1.3,1)</scale>
				</south>
				<east>
					<offset>(-0.35,-0.05)</offset>
					<thin><offset>(0.05,0)</offset></thin>
					<hulk><offset>(-0.1,0)</offset></hulk>
					<fat><offset>(-0.15,0)</offset></fat>
				</east>
				<west>
					<offset>(0.35,-0.05)</offset>
					<thin><offset>(-0.05,0)</offset></thin>
					<hulk><offset>(0.1,0)</offset></hulk>
					<fat><offset>(0.15,0)</offset></fat>
				</west>
				<male><scale>(0.8,0.8)</scale></male>
				<female><scale>(0.75,0.75)</scale></female>
				<thin><scale>(0.7,0.7)</scale></thin>
				<hulk><scale>(1.2,1.2)</scale></hulk>
				<fat><scale>(1.1,1.1)</scale></fat>
			</wornGraphicData>
			<layers>
				<li>Belt</li>
			</layers>
			<tags>
				<li>GaussCapacitorPack</li>
			</tags>
		</apparel>
		<comps>
			<li Class="GW40K_Necrons.CompProperties_GaussCapacitorApparel"/>
		</comps>
		<smeltable>true</smeltable>
		<smeltProducts>
			<Steel>5</Steel>
		</smeltProducts>
		<tradeability>Sellable</tradeability>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
	</ThingDef>

	<!-- ===== Litho-Phagic Acid (requires GrimWorld Core) ===== -->

	<ThingDef ParentName="ResourceBase" MayRequire="Grimworld.Core">
		<defName>GW40k_LithoPhagicAcid</defName>
		<label>litho-phagic acid</label>
		<description>A "smart" acid developed by the Adeptus Mechanicus and refined by Inquisitorial biologis. Chemically inert against carbon-based tissue, it reacts violently when it detects the specific isotopes found in Necrodermis. Seeking agents bind to the metallic lattice of Necron nanobots and trigger an exothermic reaction that dissolves the living metal into an inert metallic salt.\n\nThe catch: the reaction releases superheated chlorine gas and corrosive thermal energy. Expect chemical burns.</description>
		<graphicData>
			<texPath>Things/Items/LithoPhaegicAcid</texPath>
			<graphicClass>GW40K_Necrons.Graphic_StackCountExact</graphicClass>
		</graphicData>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>350</MarketValue>
			<Mass>0.15</Mass>
		</statBases>
		<techLevel>Spacer</techLevel>
		<stackLimit>5</stackLimit>
		<thingCategories>
			<li>Medicine</li>
		</thingCategories>
		<allowedArchonexusCount>5</allowedArchonexusCount>
	</ThingDef>

	<RecipeDef MayRequire="Grimworld.Core">
		<defName>GW40k_AdministerLithoPhagicAcid</defName>
		<label>administer litho-phagic acid</label>
		<description>Administer litho-phagic acid to neutralize a necrodermis seed. The exothermic reaction will cause chemical burns proportional to the amount of necrodermis present.</description>
		<workerClass>NecronMod.RecipeWorker_LithoPhagicAcid</workerClass>
		<jobString>administering litho-phagic acid</jobString>
		<workAmount>2000</workAmount>
		<allowMixingIngredients>false</allowMixingIngredients>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>GW40k_LithoPhagicAcid</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>GW40k_LithoPhagicAcid</li>
			</thingDefs>
		</fixedIngredientFilter>
		<skillRequirements>
			<Medicine>6</Medicine>
		</skillRequirements>
		<appliedOnFixedBodyParts>
			<li>Torso</li>
		</appliedOnFixedBodyParts>
	</RecipeDef>

