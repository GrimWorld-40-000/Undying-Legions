  <!-- ===== Canoptek Spyder ===== -->
  <ThingDef ParentName="BaseNechHeavy" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>UD_Necron_CanoptekSpyder</defName>
    <label>Canoptek Spyder</label>
    <description>A Canoptek Spyder — a towering arachnid maintenance and combat construct. Power claws tear apart armored hulls while fabricator claws handle precision repairs for Canoptek swarms. An integrated particle beamer mounted atop the abdomen detonates in a wide radius on impact. A control node in the head cluster transmits binding frequencies to nearby scarabs and lesser constructs.</description>
    <modExtensions>
      <li Class="GW40K_Necrons.NecronMechExtension">
        <commandBandwidthCost>2</commandBandwidthCost>
        <coreSize>2</coreSize>
      </li>
    </modExtensions>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">2</BandwidthCost>
      <ControlTakingTime>22</ControlTakingTime>
    </statBases>
    <tools>
      <li>
        <label>left power claw</label>
        <labelNoLocation>power claw</labelNoLocation>
        <capacities><li>Scratch</li></capacities>
