	<GeneDef>
		<defName>GW_UD_RecallMemories</defName>
		<label>Recall memories</label>
		<description>. . .</description>
		<geneClass>NecronGeneUtil.Gene_AddHediff</geneClass>
		<iconPath>Genes/memory</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<modExtensions>
			<li Class="NecronGeneUtil.GeneExtension_Necron">
				<hediffDef>GW40K_Necron_RecallMemories</hediffDef>
				<severityOnAdd>1.0</severityOnAdd>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_TechnoMagic</defName>
		<label>Techno-Magic</label>
		<description>. . .</description>
		<iconPath>Genes/technomagic</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>GW_UD_NobleHabits</defName>
		<label>Noble habits</label>
		<description>. . .</description>
		<iconPath>Genes/highborn (nobility)</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
	</GeneDef>
	<ThoughtDef>
		<defName>GW_UD_NobleHabits</defName>
		<workerClass>ThoughtWorker_AlwaysActive</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<requiredGenes>
			<li>GW_UD_NobleHabits</li>
		</requiredGenes>
		<stages>
			<li>
				<label>Noble habits</label>
				<description>. . .</description>
				<baseMoodEffect>-15</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	
	<GeneDef>
		<defName>GW_UD_Royalty</defName>
		<label>Royalty</label>
		<description>. . .</description>
		<geneClass>NecronGeneUtil.Gene_RoyaltyNeed</geneClass>
		<iconPath>Genes/royalty</iconPath>
		<displayCategory>GW_UD_NecronGene</displayCategory>
		<biostatMet>0</biostatMet>
		<disablesNeeds>
			<li>Food</li>
			<li>Outdoors</li>
			<li>Indoors</li>
		</disablesNeeds>
		<modExtensions>
			<li Class="NecronGeneUtil.GeneExtension_Necron">
				<hediffDef>AmbrosiaHigh</hediffDef>
				<!-- <part>Brain</part> -->
				<severityOnAdd>1.0</severityOnAdd>
				<threshold>0.9</threshold>
				<isGiveBuffIfAnyPassThreshold>False</isGiveBuffIfAnyPassThreshold>
				<needDefs>
					<li>Joy</li>
					<li>Beauty</li>
					<li>Comfort</li>
				</needDefs>
			</li>
		</modExtensions>
