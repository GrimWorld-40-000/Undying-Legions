<Defs>

    <!-- Pawn-based Immortal colonist — heavier ranged infantry, same system as Warrior. -->
    <PawnKindDef ParentName="GW40K_NecronWarriorPawnKind">
        <defName>GW_UL_NecronImmortalPawnKind_Colonist</defName>
        <label>necron immortal</label>
        <lifeStages>
          <li>
            <bodyGraphicData>
              <drawSize>1.0</drawSize>
            </bodyGraphicData>
          </li>
        </lifeStages>
        <defaultFactionType>PlayerColony</defaultFactionType>
        <race>GW40K_NecronImmortal</race>
        <combatPower>130</combatPower>
        <weaponMoney>4250~5600</weaponMoney>
        <weaponTags>
          <li>GW_Necron_Ranged_GaussBlaster</li>
          <li>GW_Necron_Ranged_TeslaCarbine</li>
        </weaponTags>
        <apparelTags Inherit="False" />
        <apparelMoney>0</apparelMoney>
        <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
        <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
        <backstoryFiltersOverride>
          <li>
            <categories>
              <li>NecronImmortal</li>
              <li>NecronLowborn</li>
            </categories>
          </li>
        </backstoryFiltersOverride>
        <techHediffsChance>0.00</techHediffsChance>
        <techHediffsMoney>0</techHediffsMoney>
        <techHediffsTags>
          <li>Poor</li>
          <li>Simple</li>
          <li>ImplantEmpireCommon</li>
        </techHediffsTags>
        <techHediffsDisallowTags>
          <li>PainCauser</li>
        </techHediffsDisallowTags>
        <initialResistanceRange>13~21</initialResistanceRange>
        <invNutrition>0</invNutrition>
        <inventoryOptions>
          <skipChance>0</skipChance>
          <subOptionsChooseOne>
            <li>
              <thingDef>GW40K_GaussCore</thingDef>
              <countRange>1</countRange>
            </li>
          </subOptionsChooseOne>
        </inventoryOptions>
        <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
          <xenotypeChances>
            <GW_UD_NecronImmortal>1</GW_UD_NecronImmortal>
          </xenotypeChances>
        </xenotypeSet>
    </PawnKindDef>

    <!-- Pawn-based Cryptothrall colonist — melee bodyguard, same system as Warrior. -->
    <PawnKindDef ParentName="GW40K_NecronWarriorPawnKind">
        <defName>GW_UL_CryptothrallPawnKind_Colonist</defName>
        <label>necron cryptothrall</label>
        <lifeStages>
          <li>
            <bodyGraphicData>
              <drawSize>1.0</drawSize>
            </bodyGraphicData>
          </li>
        </lifeStages>
        <defaultFactionType>PlayerColony</defaultFactionType>
        <race>GW40K_NecronCryptothrall</race>
        <combatPower>100</combatPower>
        <weaponMoney>0~0</weaponMoney>
        <weaponTags Inherit="False" />
        <apparelTags Inherit="False" />
        <apparelMoney>0</apparelMoney>
        <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
        <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
        <backstoryFiltersOverride>
          <li>
            <categories>
              <li>NecronCryptothrall</li>
              <li>NecronLowborn</li>
            </categories>
          </li>
        </backstoryFiltersOverride>
        <techHediffsChance>0.00</techHediffsChance>
        <techHediffsMoney>0</techHediffsMoney>
        <techHediffsTags>
          <li>Poor</li>
          <li>Simple</li>
          <li>ImplantEmpireCommon</li>
        </techHediffsTags>
        <techHediffsDisallowTags>
          <li>PainCauser</li>
        </techHediffsDisallowTags>
        <initialResistanceRange>13~21</initialResistanceRange>
        <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
          <xenotypeChances>
            <GW_UD_Cryptothrall>1</GW_UD_Cryptothrall>
          </xenotypeChances>
        </xenotypeSet>
    </PawnKindDef>

</Defs>
