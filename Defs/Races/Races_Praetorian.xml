<Defs>

  <HeadTypeDef ParentName="AverageBase">
    <defName>GW40K_Praetorian_HeadType</defName>
    <graphicPath>GW40K/NecronWarrior/Head/Male_Average_Normal</graphicPath>
    <gender>None</gender>
    <eyeOffsetEastWest>(0.18, 0, 0.17)</eyeOffsetEastWest>
	<randomChosen>false</randomChosen>
	<!-- <selectionWeight>0</selectionWeight> -->
  </HeadTypeDef>

  <ThingDef Name="GW40K_NecronPraetorian" ParentName="GW40K_BaseNecronSoldier">
    <defName>GW40K_NecronPraetorian</defName>
    <label>necron praetorian</label>
    <description>Praetorians are the ancient judges and enforcers of Necron law. They are sworn to hte Triarch and are meant to preserve the Necron empire as a whole.</description>

    <statBases>
      <MarketValue>1750</MarketValue>
      <MoveSpeed>5</MoveSpeed>
      <PsychicSensitivity>1.25</PsychicSensitivity>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0.0</Wildness>
      <MeleeDamageFactor>1.2</MeleeDamageFactor>
      <MeleeCooldownFactor>0.8</MeleeCooldownFactor>
    </statBases>

    <tools>
      <li>
        <label>metal fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>metal fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>

    <modExtensions>
      <li Class="GW40K_Necrons.NonOrganicPawn">
        <passion>Minor</passion>
        <passionType>Minor</passionType>
        <coreSize>3</coreSize>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
