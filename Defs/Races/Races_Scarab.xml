<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BasePawn">
    <defName>GW40K_ScarabSwarm</defName>
    <label>canoptek scarab swarm</label>
    <description>A swarm of Canoptek Scarabs — autonomous Necron maintenance constructs repurposed for combat. Each scarab is a small but durable metallic beetle capable of shredding flesh with its mandibles. As the swarm takes casualties the remaining scarabs fight on until the last one is destroyed.</description>
    <statBases>
      <MoveSpeed>3.65</MoveSpeed>
      <MarketValue>650</MarketValue>
      <PsychicSensitivity>0.0</PsychicSensitivity>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <Flammability>0.0</Flammability>
      <LeatherAmount>0</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>250</ComfyTemperatureMax>
    </statBases>
    <!-- Required by mechanoid validator; scarab vanishes on death so these never actually drop -->
    <butcherProducts>
      <GW40k_Necron_Necrodermis>25</GW40k_Necron_Necrodermis>
    </butcherProducts>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities><li>Cut</li></capacities>
        <power>7</power>
        <cooldownTime>0.9</cooldownTime>
      </li>
      <li>
        <label>body</label>
        <capacities><li>Blunt</li></capacities>
        <power>6</power>
        <cooldownTime>0.9</cooldownTime>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <thinkTreeMain>GW40K_ScarabSwarm</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <intelligence>Animal</intelligence>
      <body>GW40K_ScarabSwarmBody</body>
      <renderTree>GW40K_ScarabSwarm</renderTree>
      <baseBodySize>0.25</baseBodySize>
      <baseHealthScale>4.29</baseHealthScale>
      <baseHungerRate>0</baseHungerRate>
      <makesFootprints>false</makesFootprints>
      <lifeExpectancy>10000</lifeExpectancy>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <useMeatFrom>Megaspider</useMeatFrom>
      <fleshType>Mechanoid</fleshType>
      <mechWeightClass MayRequire="Ludeon.RimWorld.Biotech">Light</mechWeightClass>
      <hasCorpse>false</hasCorpse>
      <deathAction Class="GW40K_Necrons.DeathActionProperties_VanishScarab" />
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>GW40K_ScarabSwarm</defName>
    <label>canoptek scarab swarm</label>
    <race>GW40K_ScarabSwarm</race>
    <combatPower>25</combatPower>
    <aiAvoidCover>false</aiAvoidCover>
    <abilities>
      <li>GW40K_ScarabLeap</li>
      <li>GW40K_ScarabSelfDestruct</li>
    </abilities>
    <defaultFactionType>UD_NecronFaction</defaultFactionType>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>GW40K/Scarab/GW40k_Scarab</texPath>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
