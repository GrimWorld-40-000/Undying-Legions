<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>GW40K_HiveFabricator</defName>
    <label>Hive Fabricator</label>
    <description>A sophisticated nanite manufactory housed in the Spyder's abdomen. The Hive Fabricator processes necrodermis feedstock to assemble new Canoptek Scarab units on demand. Destroying the abdomen disables the system.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.90, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="GW40K_Necrons.HediffCompProperties_HiveFabricator">
        <maxStored>250</maxStored>
        <replicateCost>100</replicateCost>
        <replicateDurationTicks>2500</replicateDurationTicks>
        <necrodermisUnitsPerNeedLevel>100</necrodermisUnitsPerNeedLevel>
      </li>
    </comps>
  </HediffDef>

</Defs>
