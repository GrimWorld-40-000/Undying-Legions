        <li>
          <def>ChunkMechanoidSlag</def>
          <texOverrideIndex>3</texOverrideIndex>
          <spawnChance>0.5</spawnChance>
        </li>
      </detritusLeavings>
    </race>
    <comps>
      <li Class="GW40K_Necrons.CompProperties_HiveFabricatorInit"/>
      <!-- Burst queue comp now unused (verb handles burst natively); kept commented for rollback.
      <li Class="GW40K_Necrons.CompProperties_SpyderBurstQueue"/> -->
      <li Class="GW40K_Necrons.CompProperties_SpyderSiegeCannon"/>
      <li Class="GW40K_Necrons.CompProperties_SpyderAutoAttack">
        <commandLabel>Particle Beamer</commandLabel>
        <commandDesc>Fire the integrated particle beamer at a target. Right-click to toggle autonomous fire.</commandDesc>
      </li>
      <!-- Repair policy: stores the Spyder's master template pushed to linked scarabs on bind and on tab change. -->
      <li Class="GW40K_Necrons.CompProperties_CanoptekRepairPolicy" />
      <!-- Work mode: Work (default) + full combat suite + Patrol for area patrol. -->
      <li Class="GW40K_Necrons.CompProperties_NechWorkMode">
        <availableModes>
          <li>GW40K_NechMode_Work</li>
          <li>GW40K_NechMode_Patrol</li>
          <li>GW40K_NechMode_Escort</li>
          <li>GW40K_NechMode_Maintain</li>
          <li>GW40K_NechMode_Hold</li>
        </availableModes>
        <defaultMode>GW40K_NechMode_Work</defaultMode>
      </li>
    </comps>
    <!-- Plain li: RimWorld resolves type from loaded assemblies (GenTypes). Avoid li Class= for List<Type> inspector tabs. -->
    <inspectorTabs Inherit="True">
      <li>GW40K_Necrons.ITab_SpyderRepair</li>
    </inspectorTabs>
  </ThingDef>

