	</AbilityDef>

	<AbilityDef>
		<defName>GW40K_ScarabSelfDestruct</defName>
		<label>detonate</label>
		<description>The swarm detonates its internal power cores in a kamikaze explosion. Damage and radius scale with the number of surviving scarabs â€” a full swarm produces a devastating blast; a dying one a final, desperate pop.</description>
		<iconPath>UI/Abilities/GW40k_ScarabExplode</iconPath>
		<!-- 4-second cooldown prevents instant retry loops after a cancelled detonation. -->
		<cooldownTicksRange>240</cooldownTicksRange>
		<targetRequired>False</targetRequired>
		<!-- aiCanUse disabled: JobGiver_AIAbilityFight was firing this on wild animals.
		     Custom job givers (JobGiver_ScarabSiegeDetonate, JobGiver_ScarabBreachDetonate)
		     manage detonation with proper colony-target and staging-zone guards. -->
		<aiCanUse>false</aiCanUse>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<warmupTime>1.5</warmupTime>
			<range>1</range>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="GW40K_Necrons.ScarabSelfDestructProperties">
				<baseDamage>30</baseDamage>
				<baseRadius>4.9</baseRadius>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef ParentName="AbilityTouchBase">
		<defName>GW40k_Necron_Transmute</defName>
		<label>transmute necrodermis</label>
		<description>convert the targeted materials into necrodermis using techno-magic.</description>
		<iconPath>Things/Projectile/LauncherShot</iconPath>
		<cooldownTicksRange>50000</cooldownTicksRange><!-- 20 hours -->
		<showPsycastEffects>false</showPsycastEffects>
		<sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<drawAimPie>false</drawAimPie>
			<warmupTime>2</warmupTime>
			<range>-1</range>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetPawns>false</canTargetPawns>
				<canTargetItems>true</canTargetItems>
				<thingCategory>Item</thingCategory>
				<mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="NecronComp.CompProperties_TransmuteNecron">
				<failedMessage>Must target steel, Plasteel</failedMessage>
				<sourcePair>
					<li>
						<sourceThing>Steel</sourceThing>
						<outcomeThing>GW40k_Necron_Necrodermis</outcomeThing>
						<ratio>3</ratio>
					</li>
					<li>
						<sourceThing>Plasteel</sourceThing>
						<outcomeThing>GW40k_Necron_Necrodermis</outcomeThing>
						<ratio>3</ratio>
					</li>
				</sourcePair>
			</li>
		</comps>
	</AbilityDef>

