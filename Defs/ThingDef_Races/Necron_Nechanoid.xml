        <verbClass>GW40K_Necrons.Verb_SpyderParticleBeamer</verbClass>
        <hasStandardCommand>false</hasStandardCommand>
        <defaultProjectile>GW40K_Spyder_Bullet_ParticleBeam_Explosion</defaultProjectile>
