<Defs>
<RecipeDef ParentName="SurgeryFlesh">
  <defName>ExciseNecrodermis</defName>
  <label>excise necrodermis</label>
  <description>Carefully harvest the growing necrodermis from the host. Failure is likely as the infection progresses.</description>
  <workerClass>Recipe_RemoveHediff</workerClass>
  <jobString>Excising necrodermis.</jobString>
  <workAmount>3000</workAmount>
  <removesHediff>Necron_NecrodermisGrowth</removesHediff>
  <skillRequirements>
    <Medicine>10</Medicine>
  </skillRequirements>
  <ingredients>
    <li>
      <filter><thingDefs><li>MedicineUltratech</li></thingDefs></filter>
      <count>2</count>
    </li>
  </ingredients>
  <products>
    <!-- Yields a base amount of necrodermis upon successful removal -->
    <GW40k_Necron_Necrodermis>10</GW40k_Necron_Necrodermis> 
  </products>
  <surgerySuccessChanceFactor>0.7</surgerySuccessChanceFactor>
  <deathOnFailedSurgeryChance>0.3</deathOnFailedSurgeryChance>
</RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>GW_UD_AdministerNecrodermisInjector</defName>
    <label>administer necrodermis injector</label>
    <description>Medically inject a necrodermis seed in nutrient medium. Used for patients who will not self-administer nanite serums (non–transhumanists).</description>
    <workerClass>NecronGeneUtil.RecipeWorker_NecrodermisInjectorSurgery</workerClass>
    <jobString>Administering necrodermis injector.</jobString>
    <workAmount>2500</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>GW_NecrodermisInjector</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>GW_NecrodermisInjector</li>
      </thingDefs>
    </fixedIngredientFilter>
    <successfullyRemovedHediffMessage>{0} has successfully administered a necrodermis injector to {1}.</successfullyRemovedHediffMessage>
  </RecipeDef>
</Defs>