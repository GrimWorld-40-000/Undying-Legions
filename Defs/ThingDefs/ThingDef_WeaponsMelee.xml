		<uiIconScale>1.0</uiIconScale>				
		<statBases>
			<WorkToMake>22000</WorkToMake>
			<Mass>2.0</Mass>
			<MarketValue>3200</MarketValue>
		</statBases>
		<equippedAngleOffset>-30</equippedAngleOffset>
		<stuffCategories>
			<!-- <li>Imperial_Metals</li> -->
