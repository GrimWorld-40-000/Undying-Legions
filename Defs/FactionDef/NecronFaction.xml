        <li>name->Nakhon</li>
        <li>name->Therek</li>
        <li>name->Ramekh</li>
        <li>name->Sethnor</li>
        <li>name->Pyreth</li>
        <li>name->Ossuar</li>
        <li>name->Drazak</li>
        <li>name->Sekhmet</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <FactionDef ParentName="FactionBase">
    <defName>UD_FlayedOneFaction</defName>
    <categoryTag>NecronFlayedOnes</categoryTag>
    <label>flayed stalkers</label>
    <description>A pack of Necrons lost to the Flayer Virus — an ancient, infectious curse that drives them to stalk the living and drape themselves in trophies of flesh. They belong to no dynasty. Their minds have shattered entirely, leaving only hunger and the hollow echo of what they once were.</description>
    <pawnSingular>flayed one</pawnSingular>
    <pawnsPlural>flayed ones</pawnsPlural>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <factionNameMaker>NamerFactionFlayedOne</factionNameMaker>
    <settlementNameMaker>NamerSettlementFlayedOne</settlementNameMaker>
    <factionIconPath>UI/Icons/UndyingLegionsModIconW</factionIconPath>
    <humanlikeFaction>true</humanlikeFaction>
    <classicIdeo>true</classicIdeo>
    <fixedLeaderKinds>
      <li>UD_NecronOverlord</li>
    </fixedLeaderKinds>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <permanentEnemy>true</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Ultra</techLevel>
    <earliestRaidDays>30</earliestRaidDays>
    <backstoryFilters>
      <li>
        <categories>
          <li>NecronFlayedOne</li>
        </categories>
      </li>
    </backstoryFilters>
    <colorSpectrum>
      <li>(0.45, 0.1, 0.1)</li>
      <li>(0.65, 0.25, 0.15)</li>
      <li>(0.85, 0.6, 0.5)</li>
      <li>(0.9, 0.72, 0.6)</li>
      <li>(0.75, 0.55, 0.4)</li>
      <li>(0.6, 0.38, 0.28)</li>
      <li>(0.55, 0.4, 0.3)</li>
      <li>(0.35, 0.1, 0.1)</li>
      <li>(0.45, 0.1, 0.1)</li>
    </colorSpectrum>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300,  0)</li>
        <li>(600,  1)</li>
        <li>(1400, 1.5)</li>
        <li>(3000, 2.0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <raidLootMaker>NecronRaidLootMaker</raidLootMaker>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35,    8)</li>
        <li>(100,  40)</li>
        <li>(1000,150)</li>
        <li>(3000,250)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(300,  150)</li>
        <li>(1000, 300)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <GW_UL_NecronFlayedOnePawnKind_Colonist>10</GW_UL_NecronFlayedOnePawnKind_Colonist>
          <GW_UL_VekhThrall>3</GW_UL_VekhThrall>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <dropPodActive>ActiveDropPodMechanoid</dropPodActive>
    <dropPodIncoming>DropPodIncomingMechanoidRapid</dropPodIncoming>
  </FactionDef>

  <ThingSetMakerDef>
    <defName>NecronRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
            <li>GW40k_Necron_Necrodermis</li>
            <li>GW40K_GaussCore</li>
            <li>Plasteel</li>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

</Defs>